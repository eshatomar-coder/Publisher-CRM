@using System.Security.Claims
@using System.Text.Json
@{
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "Standard User";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var displayName = User.FindFirst(ClaimTypes.Name)?.Value ?? User.Identity?.Name ?? "SalesONE User";
    if (string.IsNullOrWhiteSpace(displayName)) displayName = "SalesONE User";
    var nameParts = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length > 1
        ? (nameParts[0].Substring(0, 1) + nameParts[nameParts.Length - 1].Substring(0, 1)).ToUpperInvariant()
        : displayName.Substring(0, Math.Min(2, displayName.Length)).ToUpperInvariant();
    const string activeModule = "SalesONE";
    var dashboardLink = Url.Content("~/Home/Index");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SalesONE</title>

    <!-- Preserve the application's existing dependencies and view styling. -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Publisher_CRM.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/jpeg" href="https://cdn.shopify.com/s/files/1/0578/8198/5133/files/New_logo.png?v=1760779157" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Existing Razor views may rely on Tailwind utilities. Do not enable preflight. -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { corePlugins: { preflight: false } };
        // Default: compact rail. If the user expanded it earlier in this tab,
        // keep that choice across page navigation without initially flashing closed.
        try {
            if (sessionStorage.getItem('salesone.sidebar.expanded') === '1') {
                document.documentElement.classList.add('so-sidebar-preexpanded');
            }
        } catch (_) { /* session storage may be disabled */ }
    </script>

    <style>
        :root {
            --so-rail-width: 102px;
            --so-panel-width: 282px;
            --so-blue: #0754f8;
            --so-navy: #0d2149;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            letter-spacing: -.015em;
            color: #101c46;
        }

        .so-app {
            display: flex;
            height: 100vh;
            height: 100dvh;
            width: 100%;
            overflow: hidden;
            background: #f6f8ff;
        }

        .so-sidebar {
            width: var(--so-rail-width);
            flex: 0 0 auto;
            display: flex;
            flex-direction: column;
            height: 100%;
            position: relative;
            z-index: 50;
            color: #f3f6ff;
            background: linear-gradient(180deg,#0c2049 0%,#132c59 63%,#102852 100%);
            box-shadow: 3px 0 15px rgba(25,44,95,.10);
            transition: width .24s ease, transform .24s ease;
        }

        .so-app.is-expanded .so-sidebar, .so-sidebar-preexpanded .so-sidebar {
            width: var(--so-panel-width);
        }

        .so-sidebar * {
            box-sizing: border-box;
        }

        .so-brand {
            position: relative;
            height: 85px;
            min-height: 85px;
            padding: 15px 9px 9px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .so-brand-link {
            color: #fff;
            text-decoration: none !important;
            display: flex;
            align-items: center;
            flex-direction: column;
            gap: 2px;
            min-width: 0;
        }

            .so-brand-link:hover {
                color: #fff;
            }

        .so-brand-symbol {
            height: 34px;
            width: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 23px;
            line-height: 1;
            letter-spacing: -4px;
            color: #fff;
            border-radius: 12px;
            transform: skew(-9deg);
            background: linear-gradient(135deg, #06c3fa 0%, #0874ff 50%, #5054ff 100%);
            box-shadow: 0 6px 15px rgba(0,100,255,.25);
        }

        .so-brand-compact {
            display: block;
            font-size: 11px;
            line-height: 1.3;
            font-weight: 600;
            color: #2baeff;
            margin-top: 1px;
        }

        .so-brand-logo {
            height: 38px;
            max-width: 55px;
            object-fit: contain;
            transition: all .24s ease;
        }

        .so-app.is-expanded .so-brand-logo, .so-sidebar-preexpanded .so-brand-logo {
            height: 44px;
            max-width: 120px;
        }

        .so-expand-icon-svg {
            transition: transform .24s ease;
        }

                                  .so-app.is-expanded .so-expand-icon-svg, .so-sidebar-preexpanded .so-expand-icon-svg {
                                  transform: rotate(180deg);
                                  }

        .so-app.is-expanded .so-brand, .so-sidebar-preexpanded .so-brand {
            justify-content: flex-start;
            padding: 16px 22px;
        }

        .so-app.is-expanded .so-brand-link, .so-sidebar-preexpanded .so-brand-link {
            flex-direction: row;
            gap: 12px;
        }

        .so-app.is-expanded .so-brand-compact, .so-sidebar-preexpanded .so-brand-compact {
            display: none;
        }

        .so-app.is-expanded .so-brand-long, .so-sidebar-preexpanded .so-brand-long {
            display: block;
        }

        .so-brand-long .so-brand-title, .so-brand-long .so-brand-subtitle {
            display: block;
        }

        .so-brand-title {
            font-size: 16px; /* Reduced from 20px */
            font-weight: 700; /* Reduced from 800 */
            color: #f8fafc; /* Slightly softer white */
            line-height: 1.1;
            letter-spacing: 0.5px;
        }

        .so-brand-subtitle {
            font-size: 9px; /* Reduced to match the new title scale */
            font-weight: 600;
            color: #84b6fd;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-top: 2px;
        }

        .so-sidebar-nav {
            flex: 1;
            min-height: 0;
            padding: 1px 6px 16px;
            overflow-x: hidden;
            overflow-y: auto;
            overscroll-behavior: contain;
        }

            .so-sidebar-nav::-webkit-scrollbar {
                width: 4px;
            }

            .so-sidebar-nav::-webkit-scrollbar-thumb {
                background: #3c5182;
                border-radius: 8px;
            }

        .so-menu-group {
            margin: 0 0 11px;
        }

        .so-menu-heading {
            display: none;
            margin: 14px 14px 7px;
            font-size: 10px;
            font-weight: 800;
            color: #8199c6;
            letter-spacing: .13em;
            text-transform: uppercase;
        }

        .so-app.is-expanded .so-menu-heading, .so-sidebar-preexpanded .so-menu-heading {
            display: block;
        }

        .so-menu-item {
            width: 100%;
            min-height: 65px;
            padding: 8px 3px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 5px;
            color: #edf4ff !important;
            text-align: center;
            font-size: 10px;
            font-weight: 600;
            line-height: 1.15;
            text-decoration: none !important;
            border-radius: 13px;
            border: 0;
            background: transparent;
            transition: background .18s ease, box-shadow .18s ease;
        }

            .so-menu-item:hover, .so-menu-item:focus-visible {
                color: white !important;
                background: rgba(92,143,253,.20);
                outline: none;
            }

            .so-menu-item.active {
                background: linear-gradient(160deg,#0874ff,#064cee);
                box-shadow: 0 5px 13px rgba(0,70,229,.3);
            }

            .so-menu-item .so-menu-icon {
                flex: none;
                width: 24px;
                height: 24px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

        .so-menu-icon svg {
            width: 22px;
            height: 22px;
            stroke-width: 2.2;
        }

        .so-menu-item .so-menu-label {
            display: block;
            white-space: normal;
            max-width: 87px;
            overflow-wrap: anywhere;
        }

        .so-menu-item .so-compact-label {
            display: block;
        }

        .so-menu-item .so-full-label {
            display: none;
        }

        .so-menu-item.so-secondary {
            display: none;
        }

            .so-menu-item.so-secondary.active {
                display: flex;
            }

        .so-app.is-expanded .so-sidebar-nav, .so-sidebar-preexpanded .so-sidebar-nav {
            padding: 5px 10px 15px;
        }

        .so-app.is-expanded .so-menu-item, .so-sidebar-preexpanded .so-menu-item {
            flex-direction: row;
            justify-content: flex-start;
            text-align: left;
            min-height: 45px;
            padding: 10px 14px;
            gap: 14px;
            font-size: 13px;
            border-radius: 11px;
        }

            .so-app.is-expanded .so-menu-item .so-menu-icon, .so-sidebar-preexpanded .so-menu-item .so-menu-icon {
                font-size: 19px;
            }

            .so-app.is-expanded .so-menu-item .so-menu-label, .so-sidebar-preexpanded .so-menu-item .so-menu-label {
                max-width: none;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .so-app.is-expanded .so-menu-item .so-compact-label, .so-sidebar-preexpanded .so-menu-item .so-compact-label {
                display: none;
            }

            .so-app.is-expanded .so-menu-item .so-full-label, .so-sidebar-preexpanded .so-menu-item .so-full-label {
                display: block;
            }

            .so-app.is-expanded .so-menu-item.so-secondary, .so-sidebar-preexpanded .so-menu-item.so-secondary {
                display: flex;
            }

        .so-sidebar-footer {
            border-top: 1px solid rgba(206,220,255,.09);
            flex: none;
            padding: 9px 6px 17px;
        }

            .so-sidebar-footer .so-menu-item {
                cursor: pointer;
            }

        .so-help-note {
            display: none;
            color: #dce8ff;
            background: #1b3971;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 12px;
            padding: 12px;
            margin: 0 7px 10px;
            font-size: 11px;
            line-height: 1.5;
        }

            .so-help-note.is-visible {
                display: block;
            }

        .so-content {
            flex: 1;
            min-width: 0;
            min-height: 0;
            display: flex;
            flex-direction: column;
            position: relative;
            background: radial-gradient(ellipse at 70% 0%, #e4ecff 0%, transparent 55%), #f4f7fe;
        }

        /* 2. Transparent, borderless, more compact top bar */
        .so-topbar {
            height: 60px;
            flex: 0 0 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 8px 24px 4px;
            position: relative;
            z-index: 40;
            border-bottom: none;
            background: transparent;
        }

        #sidebarToggleBtn {
            display: none;
        }

        /* 4. Frameless right-side bookmark icon button */
        #globalStarBtn {
            width: 36px;
            height: 36px;
            border: none;
            border-radius: 10px;
            background: transparent;
            color: #334155;
            box-shadow: none;
        }

            #globalStarBtn:hover,
            #globalStarBtn:focus-visible {
                background: rgba(30, 78, 213, 0.08);
                color: #0754f8;
                box-shadow: none;
            }

        .so-header-left, .so-header-right {
            display: flex;
            align-items: center;
            min-width: 0;
        }

        .so-header-left {
            flex: 1;
            gap: 12px;
        }

        .so-header-right {
            flex: none;
            gap: 18px;
        }

        .so-icon-btn {
            flex: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border: 1px solid #e3e9ff;
            border-radius: 13px;
            background: rgba(255,255,255,.9);
            color: #1e4ed5;
            font-size: 18px;
            cursor: pointer;
            transition: background .18s, box-shadow .18s;
        }

            .so-icon-btn svg {
                width: 19px;
                height: 19px;
            }

        #sidebarToggleIcon {
            transition: transform .22s ease;
        }

            #sidebarToggleIcon.so-rotated {
                transform: scaleX(-1);
            }

        .so-icon-btn:hover, .so-icon-btn:focus-visible {
            background: #eff4ff;
            box-shadow: 0 3px 10px #1d4bcc14;
        }

        .so-global-search {
            width: min(400px, 100%);
            position: relative;
        }

        /* Replace .so-global-search-input and .so-search-icon (around lines 459–482) */
        .so-global-search-input {
            width: 100%;
            height: 38px;
            margin: 0;
            border: 1px solid rgba(203, 213, 235, 0.7);
            outline: none;
            background: rgba(236, 241, 252, 0.75);
            border-radius: 10px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 500;
            color: #1e293b;
            padding: 0 44px 0 38px;
            box-shadow: none;
            transition: background .18s ease, border-color .18s ease, box-shadow .18s ease;
        }

            .so-global-search-input::placeholder {
                color: #64748b;
                opacity: 1;
            }

            .so-global-search-input:focus {
                outline: none;
                background: #ffffff;
                border-color: #93b4ff;
                box-shadow: 0 0 0 3px rgba(7, 84, 248, 0.10);
            }

        .so-search-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            width: 16px;
            height: 16px;
            pointer-events: none;
        }

        .so-search-kbd {
            position: absolute;
            right: 13px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 11px;
            font-weight: 600;
            padding: 0;
            color: #7c8aa5;
            border-radius: 0;
            background: transparent;
            pointer-events: none;
        }

        .so-search-results {
            position: absolute;
            top: calc(100% + 9px);
            left: 0;
            width: min(600px, calc(100vw - 36px));
            max-height: 65vh;
            overflow: auto;
            background: white;
            border: 1px solid #dfe6f8;
            border-radius: 15px;
            box-shadow: 0 20px 50px rgba(25,51,101,.16);
            padding: 9px;
            z-index: 200;
        }

            .so-search-results[hidden] {
                display: none !important;
            }

        .so-search-title {
            margin: 6px 10px;
            color: #8b97b3;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 10px;
            font-weight: 800;
        }

        .so-search-result {
            padding: 10px 12px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none !important;
            color: #172c66 !important;
            font-size: 12px;
            font-weight: 600;
        }

            .so-search-result:hover {
                background: #edf3ff;
            }

            .so-search-result .so-result-icon {
                color: #0959fa;
                width: 19px;
                height: 19px;
                display: inline-flex;
            }

                .so-search-result .so-result-icon svg {
                    width: 18px;
                    height: 18px;
                }

            .so-search-result small {
                margin-left: auto;
                color: #8a96b3;
                font-size: 10px;
                white-space: nowrap;
            }

        .so-user-menu {
            position: relative;
        }

            .so-user-menu > summary {
                list-style: none;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 9px;
                min-width: 0;
            }

                .so-user-menu > summary::-webkit-details-marker {
                    display: none;
                }

        .so-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 12px;
            font-weight: 700;
            background: linear-gradient(135deg, #263c8e, #0663fa);
            box-shadow: 0 2px 6px rgba(25, 70, 170, .14);
            flex: none;
        }

        .so-user-details {
            display: flex;
            flex-direction: column;
            min-width: 0;
            max-width: 172px;
            line-height: 1.25;
        }

        .so-user-name {
            font-weight: 700;
            font-size: 13px;
            color: #0f172a;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .so-user-role {
            color: #64748b;
            font-size: 11px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .so-profile-popover {
            position: absolute;
            top: 48px;
            right: 0;
            width: 230px;
            border: 1px solid #e2e8f8;
            background: #fff;
            box-shadow: 0 18px 35px rgba(22,50,111,.16);
            border-radius: 14px;
            padding: 12px;
            z-index: 100;
        }

        .so-profile-caption {
            padding: 5px 5px 11px;
            border-bottom: 1px solid #eff2fa;
            margin-bottom: 10px;
        }

        .so-logout-btn {
            width: 100%;
            border: 0;
            border-radius: 9px;
            background: #f2f5ff;
            color: #28418d;
            padding: 10px;
            text-align: left;
            font-family: inherit;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

            .so-logout-btn:hover {
                background: #ffecec;
                color: #b52236;
            }

        .so-page {
            flex: 1 1 auto;
            min-height: 0;
            min-width: 0;
            overflow: auto;
            position: relative;
        }

        .custom-scroll::-webkit-scrollbar {
            height: 6px;
            width: 6px;
        }

        .custom-scroll::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scroll::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 999px;
        }

        .so-mobile-overlay {
            display: none;
        }

        @@media (max-width: 860px) {
            #sidebarToggleBtn {
                display: inline-flex;
            }

            .so-search-icon {
                left: 12px;
                top: 50%;
            }

            .so-header-left {
                gap: 8px;
            }

            .so-header-right {
                gap: 7px;
            }

            .so-user-details {
                display: none;
            }

            .so-icon-btn {
                width: 36px;
                height: 36px;
            }

            .so-search-kbd {
                display: none;
            }

            .so-global-search-input {
                height: 39px;
                padding-right: 10px;
                padding-left: 37px;
            }

            .so-sidebar, .so-app.is-expanded .so-sidebar, .so-sidebar-preexpanded .so-sidebar {
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                height: 100%;
                width: min(282px, 85vw) !important;
                transform: translateX(-110%);
                z-index: 1050;
            }

                .so-sidebar.mobile-open, .so-app.is-expanded .so-sidebar.mobile-open {
                    transform: translateX(0);
                }

            .so-mobile-overlay.open {
                display: block;
                position: fixed;
                inset: 0;
                background: rgba(10,23,53,.48);
                z-index: 1040;
            }

            .so-sidebar .so-brand {
                justify-content: flex-start;
                padding: 16px 22px;
            }

            .so-sidebar .so-brand-link {
                flex-direction: row;
                gap: 12px;
            }

            .so-sidebar .so-brand-compact {
                display: none;
            }

            .so-sidebar .so-brand-long {
                display: block;
            }

            .so-sidebar .so-menu-heading {
                display: block;
            }

            .so-sidebar .so-sidebar-nav {
                padding: 5px 10px 15px;
            }

            .so-sidebar .so-menu-item {
                flex-direction: row;
                justify-content: flex-start;
                text-align: left;
                min-height: 45px;
                padding: 10px 14px;
                gap: 14px;
                font-size: 13px;
            }

                .so-sidebar .so-menu-item .so-menu-icon {
                    font-size: 19px;
                }

                .so-sidebar .so-menu-item .so-menu-label {
                    max-width: none;
                    white-space: nowrap;
                }

                .so-sidebar .so-menu-item .so-compact-label {
                    display: none;
                }

                .so-sidebar .so-menu-item .so-full-label {
                    display: block;
                }

                .so-sidebar .so-menu-item.so-secondary {
                    display: flex;
                }
        }

        @@media (max-width: 480px) {
            .so-header-right {
                gap: 5px;
            }

                .so-header-right #globalStarBtn {
                    display: none;
                }

            .so-user-menu > summary {
                gap: 3px;
            }

            .so-topbar {
                padding: 0 9px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .so-sidebar, .so-menu-item {
                transition: none;
            }
        }
    </style>
</head>
<body>
    <div id="salesoneApp" class="so-app">
        <div id="mobileOverlay" class="so-mobile-overlay" aria-hidden="true"></div>

        <!-- Updated Sidebar -->
        <aside id="main-sidebar-@activeModule" class="so-sidebar sidebar-container" aria-label="Primary navigation">
            <div class="so-brand">
                <a class="so-brand-link" href="@dashboardLink" title="Pegasus SalesONE Home">
                    <!-- New Pegasus Logo -->
                    <img src="https://cdn.shopify.com/s/files/1/0578/8198/5133/files/New_logo.png?v=1760779157" alt="Pegasus" class="so-brand-logo" />
                    <span class="so-brand-long">
                        <span class="so-brand-title d-block">SalesONE</span>
                        <span class="so-brand-subtitle d-block"></span>
                    </span>
                </a>
            </div>

            <nav id="sidebarContent" class="so-sidebar-nav custom-scroll" aria-label="SalesONE pages"></nav>
            
            <div class="so-sidebar-footer">
                <!-- New Expand/Collapse Toggle Button -->
                <button id="sidebarExpandBottomBtn" type="button" class="so-menu-item" style="cursor:pointer" title="Toggle Menu">
                    <span class="so-menu-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="so-expand-icon-svg">
                            <path d="m11 17 5-5-5-5M4 17l5-5-5-5" />
                        </svg>
                    </span>
                    <span class="so-menu-label"><span class="so-full-label">Collapse Menu</span></span>
                </button>
            </div>
        </aside>

        <div class="so-content">
            <header id="main-topbar-@activeModule" class="so-topbar">
                <div class="so-header-left">
                    <button id="sidebarToggleBtn" type="button" class="so-icon-btn" aria-label="Expand sidebar" title="Expand or collapse menu" aria-controls="main-sidebar-@activeModule" aria-expanded="false">
                        <svg id="sidebarToggleIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3" /><path d="M9 4v16" /><path d="m13 10 3 2-3 2" /></svg>
                    </button>
                    <div id="globalSearchContainer" class="so-global-search">
                        <svg class="so-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m16 16 5 5" /></svg>
                        <input id="globalSearchInput" class="so-global-search-input" type="search" placeholder="Search accounts, leads, deals..." autocomplete="off" aria-label="Search application pages" aria-controls="globalSearchResults" aria-expanded="false" />
                        <span class="so-search-kbd" aria-hidden="true">/</span>
                        <div id="globalSearchResults" class="so-search-results custom-scroll" role="region" aria-label="Search results" hidden>
                            <div id="globalSearchResultsBody"></div>
                        </div>
                    </div>
                </div>
                <div class="so-header-right">
                    <!-- Retain the existing bookmarking integration, when supplied by site.js. -->
                    <button id="globalStarBtn" class="so-icon-btn" type="button" title="Bookmark current page" aria-label="Bookmark current page" onclick="if (typeof toggleCurrentPageStar === 'function') toggleCurrentPageStar()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 2.8 5.8 6.4.9-4.6 4.5 1.1 6.4-5.7-3-5.7 3 1.1-6.4L2.8 9.7l6.4-.9z" /></svg>
                    </button>
                    <details id="userMenu" class="so-user-menu">
                        <summary aria-label="User menu">
                            <span class="so-avatar">@initials</span>
                            <span class="so-user-details"><span class="so-user-name">@displayName</span><span class="so-user-role">@userRole <i class="bi bi-chevron-down" aria-hidden="true"></i></span></span>
                        </summary>
                        <div class="so-profile-popover">
                            <div class="so-profile-caption"><div class="so-user-name">@displayName</div><div class="so-user-role">@userRole</div></div>
                            <form asp-controller="User" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="so-logout-btn"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sign Out</button>
                            </form>
                        </div>
                    </details>
                </div>
            </header>

            <!-- Page-specific views remain untouched, including Account/Index.cshtml. -->
            <main role="main" class="so-page custom-scroll" id="mainContent">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Preserve dependencies in their existing order. -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Safely generated from actual ASP.NET Core claims and route data.
        window.currentUserRole = @Html.Raw(JsonSerializer.Serialize(userRole));
        window.currentModule = @Html.Raw(JsonSerializer.Serialize(activeModule));
        window.currentController = @Html.Raw(JsonSerializer.Serialize(currentController));

        // KEEP THESE EXISTING CONTROLLER/ACTION URLS. Only presentation has changed.
        window.systemRoutes = {
            SalesONE: [
                { category: 'MAIN', title: 'Dashboard', shortTitle: 'Home', icon: 'bi-house-door', url: '@Url.Content("~/Home/Index")', type: 'Page', roles: ['All'] },
                { category: 'MAIN', title: 'Customer Management', shortTitle: 'Accounts', icon: 'bi-buildings', url: '@Url.Content("~/Account/Index")', type: 'Page', roles: ['All'], primary: true },
                { category: 'MAIN', title: 'Enquiry Management', shortTitle: 'Leads', icon: 'bi-people', url: '@Url.Content("~/Lead/Index")', type: 'Page', roles: ['All'], primary: true },
                { category: 'MAIN', title: 'Order Management', shortTitle: 'Orders', icon: 'bi-briefcase', url: '@Url.Content("~/OrderManagement/Index")', type: 'Page', roles: ['All'], primary: true },
                { category: 'MAIN', title: 'Contact', shortTitle: 'Contacts', icon: 'bi-person-lines-fill', url: '@Url.Content("~/Contact/Index")', type: 'Page', roles: ['All'] },

                { category: 'MANAGEMENT', title: 'Sales Call Management', shortTitle: 'Calls', icon: 'bi-telephone', url: '@Url.Content("~/SalesCall/Index")', type: 'Page', roles: ['All'], primary: true },
                { category: 'MANAGEMENT', title: 'Payment Management', shortTitle: 'Payments', icon: 'bi-credit-card', url: '@Url.Content("~/Payment/Index")', type: 'Page', roles: ['All'], primary: true },
                { category: 'MANAGEMENT', title: 'Zone Management', shortTitle: 'Zones', icon: 'bi-geo-alt', url: '@Url.Content("~/Zone/Index")', type: 'Page', roles: ['All'] },
                { category: 'MANAGEMENT', title: 'Plan Management', shortTitle: 'Plans', icon: 'bi-grid-1x2', url: '@Url.Content("~/Plan/Index")', type: 'Page', roles: ['All'], primary: true },
                { category: 'MANAGEMENT', title: 'Project Management', shortTitle: 'Projects', icon: 'bi-kanban', url: '@Url.Content("~/ProjectManagement/Index")', type: 'Page', roles: ['All'] },

                { category: 'MASTERS', title: 'Remark Master', shortTitle: 'Remarks', icon: 'bi-chat-square-text', url: '@Url.Content("~/Remark/Index")', type: 'Page', roles: ['All'] },
                { category: 'MASTERS', title: 'Issue Master', shortTitle: 'Issues', icon: 'bi-exclamation-circle', url: '@Url.Content("~/Issue/Index")', type: 'Page', roles: ['All'] },
                { category: 'MASTERS', title: 'Event Master', shortTitle: 'Events', icon: 'bi-calendar-event', url: '@Url.Content("~/EventMaster/Index")', type: 'Page', roles: ['All'] },
                { category: 'MASTERS', title: 'PostCodes', shortTitle: 'PostCodes', icon: 'bi-geo', url: '@Url.Content("~/Postcode/Index")', type: 'Page', roles: ['All'] },

                { category: 'CATALOGUE', title: 'Catalogue Maker', shortTitle: 'Maker', icon: 'bi-journal-plus', url: '@Url.Content("~/Catalogue/Create")', type: 'Page', roles: ['All'] },
                { category: 'CATALOGUE', title: 'My Catalogues', shortTitle: 'Catalogues', icon: 'bi-journals', url: '@Url.Content("~/Catalogue/Index")', type: 'Page', roles: ['All'] },

                { category: 'ADMIN', title: 'Users', shortTitle: 'Users', icon: 'bi-person-gear', url: '@Url.Content("~/User/Index")', type: 'Settings', roles: ['Admin'] },
                { category: 'ADMIN', title: 'Roles', shortTitle: 'Roles', icon: 'bi-shield-lock', url: '@Url.Content("~/Roles/Index")', type: 'Settings', roles: ['Admin'] }
            ]
        };

        const soApp = document.getElementById('salesoneApp');
        const soSidebar = document.getElementById('main-sidebar-SalesONE');
        const soOverlay = document.getElementById('mobileOverlay');
        const soToggle = document.getElementById('sidebarToggleBtn');
        const soToggleIcon = document.getElementById('sidebarToggleIcon');
        const soMobileQuery = window.matchMedia('(max-width: 860px)');
        const soSearchResults = document.getElementById('globalSearchResults');
        const soSearchInput = document.getElementById('globalSearchInput');

        function soGetRoutes() {
            return (window.systemRoutes[window.currentModule] || []).filter(route => {
                if (route.type === 'Permissions' || route.hideInSidebar) return false;
                if (!(route.roles.includes('All') || route.roles.includes(window.currentUserRole))) return false;
                if (Array.isArray(window.userRouteAccess)) {
                    const identifier = route.url || route.title;
                    const access = window.userRouteAccess.find(a => a.routeUrl === identifier);
                    if (access && access.isAllowed === false) return false;
                }
                return true;
            });
        }

        function soIsActive(url) {
            try {
                const target = new URL(url, window.location.origin);
                const here = new URL(window.location.href);
                const path = p => p.replace(/\/+$/, '').toLowerCase() || '/';
                if (path(target.pathname) === path(here.pathname) && (!target.search || target.search === here.search)) return true;
                // Keep the section highlighted on controller-level Create/Edit/Details pages.
                const targetController = target.pathname.split('/').filter(Boolean).slice(-2, -1)[0];
                const activeController = window.currentController;
                return !!targetController && targetController.toLowerCase() === activeController.toLowerCase() &&
                    soGetRoutes().filter(r => new URL(r.url, window.location.origin).pathname.split('/').filter(Boolean).slice(-2, -1)[0]?.toLowerCase() === activeController.toLowerCase()).length === 1;
            } catch (_) { return false; }
        }

        // Inline line icons avoid reliance on icon-font requests for the sidebar.
        // The route keys above are intentionally unchanged for compatibility.
        function soSvg(icon) {
            const paths = {
                'bi-house-door': '<path d="m3 10 9-7 9 7"/><path d="M5 9v12h14V9"/><path d="M9 21v-8h6v8"/>',
                'bi-buildings': '<rect x="4" y="3" width="12" height="18" rx="1"/><path d="M16 9h4v12H4M8 7h1m3 0h1M8 11h1m3 0h1M8 15h1m3 0h1M9 21v-3h3v3"/>',
                'bi-people': '<circle cx="10" cy="8" r="3"/><path d="M3 21v-2a7 7 0 0 1 14 0v2"/><path d="M17 5a3 3 0 0 1 0 6M19 15a6 6 0 0 1 2 4v2"/>',
                'bi-briefcase': '<rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12c5 4 13 4 18 0M12 13v3"/>',
                'bi-person-lines-fill': '<rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="10" r="2"/><path d="M5.5 17a3.5 3.5 0 0 1 7 0M15 9h4m-4 4h4m-4 4h4"/>',
                'bi-telephone': '<path d="M22 17.5v3a2 2 0 0 1-2.2 2A20 20 0 0 1 2.5 5.2 2 2 0 0 1 4.5 3h3l2.5 5-3 2a16 16 0 0 0 7 7l2-3z"/>',
                'bi-credit-card': '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h3"/>',
                'bi-geo-alt': '<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="2.5"/>',
                'bi-grid-1x2': '<rect x="3" y="3" width="7" height="18" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
                'bi-kanban': '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v14M15 3v8M6 7v6m6-6v3m6-3v5"/>',
                'bi-chat-square-text': '<path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H9l-6 3V6a2 2 0 0 1 2-2z"/><path d="M8 9h9M8 13h7"/>',
                'bi-exclamation-circle': '<circle cx="12" cy="12" r="10"/><path d="M12 7v6m0 4h.01"/>',
                'bi-calendar-event': '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18M8 15h3v3H8z"/>',
                'bi-geo': '<path d="M3 6 9 3l6 3 6-3v15l-6 3-6-3-6 3zM9 3v15m6-12v15"/>',
                'bi-journal-plus': '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 3v18m5-12v7m-3.5-3.5h7"/>',
                'bi-journals': '<rect x="5" y="3" width="15" height="18" rx="2"/><path d="M5 7H3v14h15M9 8h7M9 12h7M9 16h5"/>',
                'bi-person-gear': '<circle cx="10" cy="8" r="3"/><path d="M3 21v-2a7 7 0 0 1 10-6.3M19 15v2m-3.5 1 1.7 1m3.6-1 1.7-1m-3.5-2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z"/>',
                'bi-shield-lock': '<path d="m12 2 9 4v6c0 6-4 9-9 11-5-2-9-5-9-11V6z"/><rect x="9" y="12" width="6" height="5" rx="1"/><path d="M10 12v-1a2 2 0 0 1 4 0v1"/>'
            };
            return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (paths[icon] || '<circle cx="12" cy="12" r="8"/>') + '</svg>';
        }

        // Compatible with the former layout's public helper, used by its search UI.
        window.getIconForTitle = function (title) {
            const route = soGetRoutes().find(r => r.title.toLowerCase() === String(title).toLowerCase());
            return soSvg(route?.icon || 'bi-grid');
        };

        window.buildDynamicSidebar = function (userPrefs) {
            const nav = document.getElementById('sidebarContent');
            if (!nav) return;
            const routes = soGetRoutes();
            const previousScroll = nav.scrollTop;
            nav.replaceChildren();
            const categories = [...new Set(routes.map(route => route.category))];
            for (const category of categories) {
                const group = document.createElement('section');
                group.className = 'so-menu-group';
                const heading = document.createElement('div');
                heading.className = 'so-menu-heading';
                heading.textContent = category;
                group.appendChild(heading);
                for (const route of routes.filter(r => r.category === category)) {
                    const link = document.createElement('a');
                    link.className = 'so-menu-item menu-item' + (route.primary ? '' : ' so-secondary');
                    link.href = route.url;
                    link.title = route.title;
                    link.setAttribute('aria-label', route.title);
                    link.dataset.routeUrl = route.url;
                    const icon = document.createElement('span');
                    icon.className = 'so-menu-icon';
                    icon.setAttribute('aria-hidden', 'true');
                    icon.innerHTML = soSvg(route.icon);
                    const label = document.createElement('span');
                    label.className = 'so-menu-label';
                    const compact = document.createElement('span');
                    compact.className = 'so-compact-label';
                    compact.textContent = route.shortTitle || route.title;
                    const full = document.createElement('span');
                    full.className = 'so-full-label';
                    full.textContent = route.title;
                    label.append(compact, full);
                    link.append(icon, label);
                    group.appendChild(link);
                }
                nav.appendChild(group);
            }
            window.highlightActiveSidebarLink();
            nav.scrollTop = previousScroll;
        };

        window.highlightActiveSidebarLink = function () {
            document.querySelectorAll('#sidebarContent .menu-item').forEach(link => {
                const selected = soIsActive(link.getAttribute('href'));
                link.classList.toggle('active', selected);
                if (selected) link.setAttribute('aria-current', 'page');
                else link.removeAttribute('aria-current');
            });
        };

        function soEscape(value) {
            return String(value).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]);
        }
        // Retain the previous public buildSection() function for integration code.
        window.buildSection = function (title, items) {
            if (!items.length) return '';
            const links = items.filter(item => item.url).map(item =>
                '<a class="so-search-result" href="' + soEscape(item.url) + '">' +
                '<span class="so-result-icon">' + soSvg(item.icon) + '</span>' +
                '<span>' + soEscape(item.title) + '</span>' +
                '<small>' + soEscape(item.category) + '</small></a>'
            ).join('');
            return '<div class="so-search-title">' + soEscape(title) + ' (' + items.length + ')</div>' + links;
        };
        window.handleGlobalSearch = function (queryText) {
            const resultsBody = document.getElementById('globalSearchResultsBody');
            const query = String(queryText || '').trim().toLowerCase();
            if (!query) { soCloseSearch(); return; }
            const matches = soGetRoutes().filter(r =>
                [r.title, r.shortTitle, r.category].some(s => String(s || '').toLowerCase().includes(query))
            );
            resultsBody.innerHTML = matches.length
                ? window.buildSection('Pages & Results', matches)
                : '<div style="padding:20px;color:#8390ae;font-size:12px;text-align:center">No matching pages found.</div>';
            soSearchResults.hidden = false;
            soSearchInput.setAttribute('aria-expanded', 'true');
        };
        function soCloseSearch() {
            soSearchResults.hidden = true;
            soSearchInput.setAttribute('aria-expanded', 'false');
        }

        function soUpdateToggle() {
            const mobile = soMobileQuery.matches;
            const open = mobile ? soSidebar.classList.contains('mobile-open') : soApp.classList.contains('is-expanded');
            soToggle.setAttribute('aria-expanded', String(open));
            soToggle.setAttribute('aria-label', open ? 'Collapse sidebar' : 'Expand sidebar');
            soToggleIcon.classList.toggle('so-rotated', open);
        }
        function soCloseMobile() {
            soSidebar.classList.remove('mobile-open');
            soOverlay.classList.remove('open');
            document.body.style.overflow = '';
            soUpdateToggle();
        }
        function soToggleSidebar() {
            if (soMobileQuery.matches) {
                const open = !soSidebar.classList.contains('mobile-open');
                soSidebar.classList.toggle('mobile-open', open);
                soOverlay.classList.toggle('open', open);
                document.body.style.overflow = open ? 'hidden' : '';
            } else {
                const expanded = !soApp.classList.contains('is-expanded');
                soApp.classList.toggle('is-expanded', expanded);
                document.documentElement.classList.toggle('so-sidebar-preexpanded', expanded);
                try { sessionStorage.setItem('salesone.sidebar.expanded', expanded ? '1' : '0'); } catch (_) { }
            }
            soUpdateToggle();
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (document.documentElement.classList.contains('so-sidebar-preexpanded')) {
                soApp.classList.add('is-expanded');
            }
            window.buildDynamicSidebar(window.globalUserPrefs);
            soUpdateToggle();
            soToggle.addEventListener('click', soToggleSidebar);
            soOverlay.addEventListener('click', soCloseMobile);
            soMobileQuery.addEventListener?.('change', () => { soCloseMobile(); soUpdateToggle(); });
            document.getElementById('sidebarExpandBottomBtn').addEventListener('click', soToggleSidebar);

            soSearchInput.addEventListener('input', event => window.handleGlobalSearch(event.target.value));
            document.addEventListener('keydown', event => {
                if (event.key === 'Escape') { soCloseSearch(); soCloseMobile(); return; }
                const activeTag = document.activeElement?.tagName || '';
                const typing = ['INPUT', 'TEXTAREA', 'SELECT'].includes(activeTag) || document.activeElement?.isContentEditable;
                if (event.key === '/' && !typing && !event.ctrlKey && !event.altKey && !event.metaKey) {
                    event.preventDefault();
                    soSearchInput.focus();
                }
            });
            document.addEventListener('click', event => {
                if (!document.getElementById('globalSearchContainer').contains(event.target)) soCloseSearch();
                const userMenu = document.getElementById('userMenu');
                if (userMenu.open && !userMenu.contains(event.target)) userMenu.open = false;
            });
            if (typeof window.checkCurrentPageStar === 'function') window.checkCurrentPageStar();
        });

        // Preserve the previous layout's immediate sidebar initialization.
        window.buildDynamicSidebar();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

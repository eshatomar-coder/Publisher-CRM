@model Publisher_CRM.Models.Postcode

@{
    ViewData["Title"] = "Manage Postcodes";
}
<style>
    body {
        background-color: #f4f7f6;
    }

    .crm-card {
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        border: none;
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .crm-header {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: white;
        padding: 25px;
    }

    .crm-header-alt {
        background: linear-gradient(135deg, #023047 0%, #219ebc 100%);
        color: white;
        padding: 20px;
    }

    .section-title {
        color: #1e3c72;
        font-weight: 700;
        font-size: 1.2rem;
        margin-bottom: 1.5rem;
        padding-bottom: 8px;
        border-bottom: 3px solid #ffb703;
        display: inline-block;
    }

    .form-section {
        background-color: #ffffff;
        padding: 25px;
        border-radius: 8px;
        margin-bottom: 25px;
        border: 1px solid #e9ecef;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
        font-size: 0.9rem;
    }

    .form-control, .form-select {
        border-radius: 6px;
        border: 1px solid #ced4da;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #ffb703;
            box-shadow: 0 0 0 0.25rem rgba(255, 183, 3, 0.25);
        }

    .btn-save {
        background-color: #ffb703;
        color: #1e3c72;
        font-weight: bold;
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        transition: 0.3s;
    }

        .btn-save:hover {
            background-color: #fb8500;
            color: white;
            transform: translateY(-2px);
        }
</style>

<div class="container py-5">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <div class="card crm-card">
        <div class="crm-header d-flex justify-content-between align-items-center">
            <h2>📍 Create New Postcode</h2>
        </div>
        <div class="card-body p-4 p-md-5">
            <form asp-action="Create" method="post">

                <div class="form-section">
                    <h4 class="section-title">Core & Location Details</h4>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="RecordId" class="form-label">Record ID</label>
                            <input asp-for="RecordId" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="ZipCode" class="form-label">Zipcodes <span class="text-danger">*</span></label>
                            <input asp-for="ZipCode" class="form-control" required />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="RecordStatus" class="form-label">Record Status</label>
                            <input asp-for="RecordStatus" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="OwnerId" class="form-label">Owner ID</label>
                            <input asp-for="OwnerId" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="City" class="form-label">City</label>
                            <input asp-for="City" class="form-control" />
                        </div>
                       
                        <div class="col-md-4">
                            <label asp-for="State_Name" class="form-label">State Name</label>
                            <input asp-for="State_Name" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="State_Code" class="form-label">State Code</label>
                            <input asp-for="State_Code" class="form-control" placeholder="e.g. UP" />
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h4 class="section-title">Contact & Regional Data</h4>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" type="email" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SecondaryEmail" class="form-label">Secondary Email</label>
                            <input asp-for="SecondaryEmail" type="email" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Currency" class="form-label">Currency</label>
                            <input asp-for="Currency" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ExchangeRate" class="form-label">Exchange Rate</label>
                            <input asp-for="ExchangeRate" type="number" step="0.01" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h4 class="section-title">CRM System Properties</h4>
                    <div class="row g-3">
                       
                        <div class="col-md-4">
                            <label asp-for="LayoutId" class="form-label">Layout ID</label>
                            <input asp-for="LayoutId" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Tag" class="form-label">Tag</label>
                            <input asp-for="Tag" class="form-control" />
                        </div>
                     

                        <div class="col-12 mt-4 d-flex flex-wrap gap-4">
                            <div class="form-check form-switch fs-5">
                                <input asp-for="Locked" class="form-check-input" type="checkbox" />
                                <label asp-for="Locked" class="form-check-label ms-2">Locked</label>
                            </div>
                            <div class="form-check form-switch fs-5">
                                <input asp-for="EmailOptOut" class="form-check-input" type="checkbox" />
                                <label asp-for="EmailOptOut" class="form-check-label ms-2">Email Opt Out</label>
                            </div>
                            <div class="form-check form-switch fs-5">
                                <input asp-for="IsRecordDuplicate" class="form-check-input" type="checkbox" />
                                <label asp-for="IsRecordDuplicate" class="form-check-label ms-2">Is Duplicate</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-save">✨ Save Manual Postcode</button>
                </div>
            </form>
        </div>
    </div>
</div>
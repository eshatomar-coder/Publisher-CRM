                            </div>
                            <div class="col-12">
                                <label class="form-label">Opportunities</label>
                                <input asp-for="Opportunities" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Final Recommendation</label>
                                <input asp-for="FinalRecommendation" class="form-control" />
                            </div>

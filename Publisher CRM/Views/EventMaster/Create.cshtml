@model Publisher_CRM.Models.EventMaster

@{
    ViewData["Title"] = "Create EventMaster";
}

<div class="container mt-4">
    <h2>Create New Event</h2>
    <hr />

    <form asp-action="Create" method="post">
        <div class="row">
            <!-- Left Column: Primary Details -->
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="EventName" class="control-label fw-bold"></label>
                    <input asp-for="EventName" class="form-control" placeholder="Enter event name" />
                    <span asp-validation-for="EventName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="EventMasterOwnerId" class="control-label fw-bold"></label>
                    <select asp-for="EventMasterOwnerId" class="form-select" asp-items="ViewBag.Users">
                        <option value="">-- Select Owner --</option>
                    </select>
                </div>


                <div class="form-group mb-3">
                    <label asp-for="EventDateFrom" class="control-label fw-bold"></label>
                    <input asp-for="EventDateFrom" class="form-control" type="date" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="EventDateTo" class="control-label fw-bold"></label>
                    <input asp-for="EventDateTo" class="form-control" type="date" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="EventLocation" class="control-label fw-bold"></label>
                    <input asp-for="EventLocation" class="form-control" placeholder="Enter location" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="EventStatus" class="control-label fw-bold"></label>
                    <!-- This TagHelper automatically reads the Enum and creates a dropdown -->
                    <select asp-for="EventStatus" class="form-select" asp-items="Html.GetEnumSelectList<EventStatus>()">
                    </select>
                </div>
            </div>

            <!-- Right Column: Metrics and Costs -->
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="NumberOfCustomerMet" class="control-label fw-bold"></label>
                    <input asp-for="NumberOfCustomerMet" class="form-control" type="number" min="0" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="SalespersonCode" class="control-label fw-bold"></label>
                    <input asp-for="SalespersonCode" class="form-control" placeholder="e.g., SP-101" />
                </div>

                <h5 class="mt-4 border-bottom pb-2">Cost Details</h5>

                <div class="form-group mb-3">
                    <label asp-for="RentalCharges" class="control-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="RentalCharges" class="form-control" type="number" step="0.01" />
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="TravelCosts" class="control-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="TravelCosts" class="form-control" type="number" step="0.01" />
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="DesigningAndSetupCharges" class="control-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="DesigningAndSetupCharges" class="form-control" type="number" step="0.01" />
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="OtherCosts" class="control-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="OtherCosts" class="form-control" type="number" step="0.01" />
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group mt-4 mb-5">
            <button type="submit" class="btn btn-primary px-4 py-2">Create Event</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@{
    ViewData["Title"] = "Project Management";
}

<style>
    body {
        background-color: #f8fafc;
        font-family: 'Segoe UI', sans-serif;
        color: #334155;
    }

    .custom-scroll::-webkit-scrollbar {
        height: 6px;
        width: 6px;
    }

    .custom-scroll::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 4px;
    }

    .custom-scroll::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }
</style>

<div class="fixed inset-0 -z-10 h-full w-full bg-slate-50 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:24px_24px]"></div>

<div class="font-sans antialiased w-full min-h-screen relative overflow-x-hidden flex flex-col items-center py-6 px-4 sm:px-6 lg:px-8 gap-4 pb-32">
    <div class="w-full lg:w-[98%] max-w-[150rem] z-10 flex flex-col gap-4">

        <!-- HEADER -->
        <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-4 relative z-[60] flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            <div class="flex items-center gap-3 shrink-0">
                <div class="w-10 h-10 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-600 border border-indigo-100 shadow-sm">
                    <i class="bi bi-kanban fs-5"></i>
                </div>
                <div>
                    <h1 class="text-xl font-extrabold text-gray-900 m-0 leading-tight">Project Management</h1>
                    <p class="text-xs font-bold text-gray-400 m-0 uppercase tracking-widest">Title Workflow Engine</p>
                </div>
            </div>

            <div class="flex items-center gap-3 w-full lg:w-auto">
                <div class="relative w-full lg:w-64">
                    <i class="bi bi-search absolute left-3 top-2.5 text-gray-400"></i>
                    <input type="text" id="searchInput" placeholder="Search ISBN, Customer, or Title..." class="w-full pl-9 pr-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm font-medium focus:border-indigo-600 focus:bg-white outline-none transition-all shadow-inner m-0" onkeyup="window.applySearch()" />
                </div>
            </div>
        </div>

        <!-- MAIN DATA TABLE -->
        <div class="bg-white/90 backdrop-blur-md rounded-2xl shadow-xl border border-gray-200 relative z-10 w-full overflow-hidden" style="min-height: 600px;">
            
            <div id="tableLoadingState" class="absolute inset-0 z-50 flex flex-col items-center justify-center bg-white/80 backdrop-blur-sm">
                <div class="spinner-border text-indigo-600 mb-3" role="status"></div>
                <h5 class="text-indigo-900 font-bold">Loading Titles...</h5>
            </div>

            <div class="w-full overflow-x-auto pb-6 custom-scroll h-[75vh]">
                <table class="w-full text-left border-collapse whitespace-nowrap min-w-max">
                    <thead class="sticky top-0 z-20 bg-white shadow-sm border-b border-gray-200">
                        <tr>
                            <th class="px-4 py-3 text-[10px] font-extrabold uppercase tracking-widest text-gray-500 border-r border-gray-100">Title ID</th>
                            <th class="px-4 py-3 text-[10px] font-extrabold uppercase tracking-widest text-gray-500 border-r border-gray-100">ISBN</th>
                            <th class="px-4 py-3 text-[10px] font-extrabold uppercase tracking-widest text-gray-500 border-r border-gray-100">Type</th>
                            <th class="px-4 py-3 text-[10px] font-extrabold uppercase tracking-widest text-gray-500 border-r border-gray-100">Item No/Name</th>
                            <th class="px-4 py-3 text-[10px] font-extrabold uppercase tracking-widest text-gray-500 border-r border-gray-100">Title Name</th>
                            <th class="px-4 py-3 text-[10px] font-extrabold uppercase tracking-widest text-gray-500 border-r border-gray-100">Lang.</th>
                            <th class="px-4 py-3 text-[10px] font-extrabold uppercase tracking-widest text-gray-500 border-r border-gray-100">Customer</th>
                            <th class="px-4 py-3 text-[10px] font-extrabold uppercase tracking-widest text-gray-500 border-r border-gray-100">Status</th>
                            <th class="px-4 py-3 text-[10px] font-extrabold uppercase tracking-widest text-gray-500 border-r border-gray-100">Remarks</th>
                            <th class="px-4 py-3 text-[10px] font-extrabold uppercase tracking-widest text-gray-500 border-r border-gray-100">Dispatch</th>
                            <th class="px-4 py-3 text-[10px] font-extrabold uppercase tracking-widest text-indigo-600 bg-indigo-50 sticky right-0 shadow-sm border-l border-indigo-100 text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm font-medium text-gray-800" id="tableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- WORKFLOW ACTION MODAL -->
<div class="modal fade" id="actionModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-2xl">
            <div class="modal-header bg-indigo-600 text-white border-0 py-3 rounded-t-2xl">
                <h5 class="modal-title fw-bold" id="actionModalTitle">Update Status</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-light p-4">
                <input type="hidden" id="actionRecordId" />
                <input type="hidden" id="actionTargetStatus" />

                <div class="alert alert-info border-0 shadow-sm fw-bold mb-4" id="actionPromptText"></div>

                <div class="mb-3" id="remarksContainer">
                    <label class="form-label text-[10px] fw-bold text-gray-500 uppercase tracking-widest">Remarks <span id="remarksAsterisk" class="text-danger d-none">*</span></label>
                    <textarea id="actionRemarks" class="form-control border-gray-300 rounded-lg shadow-sm" rows="3" placeholder="Enter processing notes or rejection reason..."></textarea>
                </div>

                <div class="mb-3 d-none" id="dateContainer">
                    <label class="form-label text-[10px] fw-bold text-gray-500 uppercase tracking-widest">File Received Date <span class="text-danger">*</span></label>
                    <input type="date" id="actionDate" class="form-control border-gray-300 rounded-lg shadow-sm" />
                </div>
            </div>
            <div class="modal-footer bg-white border-t border-gray-200 py-3">
                <button type="button" class="btn btn-light border fw-bold px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-indigo fw-bold px-4 text-white shadow-sm" style="background-color: #4f46e5;" id="btnConfirmAction">Confirm Update</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let masterData = [];

        document.addEventListener("DOMContentLoaded", function () {
            loadGridData();
        });

        function loadGridData() {
            $('#tableLoadingState').show();
            $.get('/ProjectManagement/GetProjectTitles', function (res) {
                masterData = res.data || res;
                window.renderData(masterData);
                $('#tableLoadingState').fadeOut(300);
            });
        }

        window.applySearch = function () {
            let term = $('#searchInput').val().toLowerCase();
            let filtered = masterData.filter(t =>
                (t.isbn.toLowerCase().includes(term)) ||
                (t.titleName.toLowerCase().includes(term)) ||
                (t.customerName.toLowerCase().includes(term))
            );
            window.renderData(filtered);
        };

        window.renderData = function (data) {
            let tbody = $('#tableBody');
            tbody.empty();

            if (data.length === 0) {
                tbody.html('<tr><td colspan="11" class="text-center py-10 text-gray-400 font-bold">No titles found.</td></tr>');
                return;
            }

            data.forEach(t => {
                let badgeClass = 'bg-secondary';
                if (t.status === 'Open') badgeClass = 'bg-primary';
                else if (t.status.includes('Accepted') || t.status === 'In Stock' || t.status === 'Invoiced') badgeClass = 'bg-success';
                else if (t.status.includes('Rejected')) badgeClass = 'bg-danger';
                else badgeClass = 'bg-warning text-dark';

                let itemText = t.type === 'White Labeling' ? `<span class="text-xs">${t.primaryItemNo}<br><span class="text-[10px] text-gray-400">${t.primaryItemName}</span></span>` : '-';
                
                let tr = `
                            <tr class="hover:bg-indigo-50/30 transition-colors bg-white">
                                <td class="font-mono text-indigo-600">${t.titleId}</td>
                                <td class="font-mono">${t.isbn}</td>
                                <td><span class="badge bg-dark">${t.type}</span></td>
                                <td class="whitespace-normal min-w-[120px]">${itemText}</td>
                                <td class="fw-bold text-indigo-900 whitespace-normal min-w-[180px]">${t.titleName}</td>
                                <td>${t.language}</td>
                                <td class="whitespace-normal min-w-[150px]"><span class="text-xs fw-bold">${t.customerName}</span><br><span class="text-[10px] text-gray-400">${t.customerId}</span></td>
                                <td><span class="badge ${badgeClass} shadow-sm px-2 py-1">${t.status}</span></td>
                                <td class="whitespace-normal min-w-[150px] text-xs text-gray-500">${t.remarks}</td>
                                <td class="text-xs">${t.dispatchDate}</td>
                                <td class="sticky right-0 bg-white shadow-sm border-l border-indigo-100 text-center p-2 min-w-[180px]">
                                    ${getWorkflowButtons(t.recordId, t.status)}
                                </td>
                            </tr>
                        `;
                tbody.append(tr);
            });
        };

        // --- DYNAMIC WORKFLOW BUTTON ENGINE ---
        function getWorkflowButtons(id, status) {
            let html = `<div class="d-flex flex-column gap-1 justify-content-center">`;
            
            if (status === 'Open') {
                html += `<button class="btn btn-sm btn-outline-primary fw-bold text-[10px]" onclick="openModal('${id}', 'File Sent')">Send File</button>`;
                html += `<button class="btn btn-sm btn-outline-info fw-bold text-[10px]" onclick="openModal('${id}', 'In Editorial')">Send for Editorial</button>`;
            }
            else if (status === 'File Sent') {
                html += `<button class="btn btn-sm btn-success fw-bold text-[10px]" onclick="openModal('${id}', 'File Accepted')">Accept</button>`;
                html += `<button class="btn btn-sm btn-danger fw-bold text-[10px]" onclick="openModal('${id}', 'File Rejected')">Reject</button>`;
            }
            else if (status === 'File Accepted') {
                html += `<button class="btn btn-sm btn-primary fw-bold text-[10px]" onclick="openModal('${id}', 'Sent for Printing')">Send for Printing</button>`;
            }
            else if (status === 'Sent for Printing') {
                html += `<button class="btn btn-sm btn-success fw-bold text-[10px]" onclick="openModal('${id}', 'Production Accepted')">Accept Prod</button>`;
                html += `<button class="btn btn-sm btn-danger fw-bold text-[10px]" onclick="openModal('${id}', 'Production Rejected')">Reject Prod</button>`;
            }
            else if (status === 'Production Accepted') {
                html += `<button class="btn btn-sm btn-dark fw-bold text-[10px]" onclick="openModal('${id}', 'PO Created', true)">Log File Recd Date</button>`;
            }
            else {
                html += `<span class="text-muted text-[10px] fw-bold italic">No Actions Pending</span>`;
            }

            html += `</div>`;
            return html;
        }

        window.openModal = function (recordId, targetStatus, requiresDate = false) {
            $('#actionRecordId').val(recordId);
            $('#actionTargetStatus').val(targetStatus);
            $('#actionRemarks').val('');
            $('#actionDate').val('');

            $('#actionModalTitle').text(`Move to: ${targetStatus}`);
            $('#actionPromptText').text(`You are about to change the status to "${targetStatus}".`);

            if (targetStatus.includes('Rejected')) {
                $('#remarksAsterisk').removeClass('d-none');
            } else {
                $('#remarksAsterisk').addClass('d-none');
            }

            if (requiresDate) {
                $('#dateContainer').removeClass('d-none');
            } else {
                $('#dateContainer').addClass('d-none');
            }

            $('#actionModal').modal('show');
        };

        $('#btnConfirmAction').click(function () {
            let recordId = $('#actionRecordId').val();
            let targetStatus = $('#actionTargetStatus').val();
            let remarks = $('#actionRemarks').val().trim();
            let dateVal = $('#actionDate').val();

            if (targetStatus.includes('Rejected') && remarks === '') {
                alert("Remarks are mandatory when rejecting a file or production.");
                return;
            }

            if (!$('#dateContainer').hasClass('d-none') && dateVal === '') {
                alert("Please select the File Received Date.");
                return;
            }

            let btn = $(this);
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Processing...');

            $.post('/ProjectManagement/UpdateWorkflowAction', {
                recordId: recordId,
                targetStatus: targetStatus,
                remarks: remarks,
                fileRecdDate: dateVal
            }, function (res) {
                if (res.success) {
                    $('#actionModal').modal('hide');
                    loadGridData();
                } else {
                    alert(res.message);
                }
                btn.prop('disabled', false).text('Confirm Update');
            });
        });
    </script>
}
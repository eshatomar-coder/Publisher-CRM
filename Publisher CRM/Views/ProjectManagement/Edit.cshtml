@model Publisher_CRM.Models.ProjectTitle
@{
    ViewData["Title"] = "Edit Project Title";
}

<!-- SELECT2 CSS & BOOTSTRAP 5 THEME -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f8fafc;
        font-family: 'Segoe UI', sans-serif;
        color: #334155;
    }

    .crm-card {
        background-color: #ffffff;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        margin: 0 auto 2rem auto;
        overflow: hidden;
        max-width: 1200px;
        border: 1px solid #e2e8f0;
    }

    .crm-header {
        background: #ffffff;
        padding: 20px 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #e2e8f0;
    }

        .crm-header h2 {
            margin: 0;
            font-weight: 800;
            font-size: 1.5rem;
            color: #0f172a;
        }

    .section-title {
        color: #4f46e5;
        font-weight: 800;
        font-size: 0.9rem;
        margin-bottom: 1.2rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-bottom: 2px solid #e0e7ff;
        padding-bottom: 8px;
        display: inline-block;
    }

    .form-section {
        background-color: #ffffff;
        padding: 25px 30px;
    }

    .form-section-alt {
        background-color: #f8fafc;
        padding: 25px 30px;
        border-top: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
    }

    .form-label {
        font-weight: 700;
        color: #64748b;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.4rem;
    }

    .form-control, .form-select {
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        padding: 10px 14px;
        font-weight: 600;
        font-size: 0.9rem;
    }

        .form-control:focus, .form-select:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }

        .form-control[readonly] {
            background-color: #f1f5f9;
            color: #94a3b8;
            border-color: #e2e8f0;
            cursor: not-allowed;
        }
</style>

<div class="container my-4">
    <div class="crm-card">
        <div class="crm-header">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-lg bg-amber-50 d-flex align-items-center justify-content-center text-amber-600 border border-amber-100 shadow-sm" style="width: 40px; height: 40px;">
                    <i class="bi bi-pencil-square fs-5"></i>
                </div>
                <h2 class="m-0">Edit Project Title</h2>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-indigo-600 px-3 py-2 text-[12px] shadow-sm">ID: @Model.TitleId</span>
                <a asp-action="Index" class="btn btn-light fw-bold rounded-lg px-4 shadow-sm text-dark border"><i class="bi bi-arrow-left me-2"></i>Back</a>
            </div>
        </div>

        <form id="projectForm" asp-action="Edit" method="post">
            <input type="hidden" asp-for="RecordId" />
            <input type="hidden" asp-for="TitleId" />
            <input type="hidden" asp-for="OrderRecordId" />
            <input type="hidden" asp-for="CustomerId" />
            <input type="hidden" asp-for="OwnerId" />
            <input type="hidden" asp-for="CreatedTime" />

            <div asp-validation-summary="ModelOnly" class="text-danger px-4 pt-3 fw-bold"></div>

            <!-- SECTION 1: CORE LINKING -->
            <div class="form-section">
                <h4 class="section-title"><i class="bi bi-link-45deg me-2"></i>1. Assignment & Routing</h4>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="CustomerName" class="form-label">Customer Name</label>
                        <input asp-for="CustomerName" class="form-control fw-bold" readonly />
                        <small class="text-muted" style="font-size:10px;">Customer is inherited from the original order.</small>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Type" class="form-label">Order Type <span class="text-danger">*</span></label>
                        <select asp-for="Type" class="form-select border-indigo-300 text-indigo-700 fw-bold" required>
                            <option value="">-- Select Type --</option>
                            <option value="OEM">OEM</option>
                            <option value="White Labeling">White Labeling</option>
                            <option value="Distribution">Distribution</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Stage" class="form-label">Current Status</label>
                        <select asp-for="Stage" class="form-select border-primary text-primary fw-bold">
                            <!-- All Kanban Stages Allowed -->
                            <option value="Open">Open</option>
                            <option value="File Sent">File Sent</option>
                            <option value="In Editorial">In Editorial</option>
                            <option value="File Parked">File Parked</option>
                            <option value="File Accepted">File Accepted</option>
                            <option value="File Rejected">File Rejected</option>
                            <option value="Sent for Printing">Sent for Printing</option>
                            <option value="Production Accepted">Production Accepted</option>
                            <option value="Production Rejected">Production Rejected</option>
                            <option value="PO Created">PO Created</option>
                            <option value="Sent for Ferrow">Sent for Ferrow</option>
                            <option value="Ferrow Accepted">Ferrow Accepted</option>
                            <option value="Ferrow Rejected">Ferrow Rejected</option>
                            <option value="In Printing">In Printing</option>
                            <option value="In Stock">In Stock</option>
                            <option value="Invoiced">Invoiced</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- SECTION 2: TITLE DETAILS -->
            <div class="form-section-alt">
                <h4 class="section-title text-secondary"><i class="bi bi-book me-2"></i>2. Title Specifications</h4>
                
                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <label asp-for="Isbn" class="form-label">ISBN / Barcode</label>
                        <input asp-for="Isbn" class="form-control font-mono" placeholder="Enter ISBN..." />
                    </div>
                    <div class="col-md-8">
                        <label asp-for="TitleName" class="form-label">Title Name <span class="text-danger">*</span></label>
                        <input asp-for="TitleName" class="form-control" required placeholder="Enter full title name..." />
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-4">
                        <label asp-for="PrimaryItemNo" class="form-label">Primary Item No.</label>
                        <input asp-for="PrimaryItemNo" class="form-control" placeholder="e.g. ITEM-001" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PrimaryItemName" class="form-label">Primary Item Name</label>
                        <input asp-for="PrimaryItemName" class="form-control" placeholder="Associated toy/item..." />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Language" class="form-label">Language</label>
                        <input asp-for="Language" class="form-control" placeholder="e.g. English, Spanish" />
                    </div>
                </div>
            </div>

            <!-- SECTION 3: TIMELINES & NOTES -->
            <div class="form-section">
                <h4 class="section-title"><i class="bi bi-calendar-event me-2"></i>3. Timelines & Remarks</h4>

                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <label asp-for="TentativeDispatchDate" class="form-label">Tentative Dispatch Date</label>
                        <input asp-for="TentativeDispatchDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="FileRecdDate" class="form-label">File Received Date</label>
                        <input asp-for="FileRecdDate" type="date" class="form-control" />
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-12">
                        <label asp-for="Remarks" class="form-label">Remarks & Action Log</label>
                        <textarea asp-for="Remarks" class="form-control text-xs" rows="5" placeholder="Enter production notes..."></textarea>
                        <small class="text-muted" style="font-size:10px;">Workflow rejections are automatically appended to this log.</small>
                    </div>
                </div>
            </div>

            <div class="bg-white p-4 border-top text-end">
                <a asp-action="Index" class="btn btn-light border fw-bold px-4 py-2 shadow-sm me-2 text-secondary">Cancel</a>
                <button type="submit" class="btn btn-warning fw-bold px-5 py-2 shadow-sm" id="btnUpdateTitle"><i class="bi bi-check2-all me-2"></i> Update Title</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#projectForm').on('submit', function () {
                $('#btnUpdateTitle').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Updating...');
            });
        });
    </script>
}
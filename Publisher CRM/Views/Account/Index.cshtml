        <div><h2 class="offcanvas-title" id="cmIssuesTitle"><i class="bi bi-exclamation-circle-fill" style="color:#e65e64"></i> Pending Issues</h2><div class="cm-panel-account" id="cmIssuesAccount"></div></div>
        <button class="btn-close" type="button" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

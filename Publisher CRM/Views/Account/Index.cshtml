    <div class="offcanvas-header">
        <div><h2 class="offcanvas-title" id="cmRemarksTitle"><i class="bi bi-chat-left-text-fill text-primary"></i> Account Remarks</h2><div class="cm-panel-account" id="cmRemarksAccount"></div></div>
        <button class="btn-close" type="button" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column p-0">
        <div class="cm-panel-list" id="cmRemarksList" aria-live="polite">Loading remarks...</div>
        <form class="cm-panel-bottom" id="cmRemarkForm"><label for="cmRemarkText" class="form-label fw-bold">Add a remark</label><textarea id="cmRemarkText" class="form-control" maxlength="4000" placeholder="Write your remark..." required></textarea><button type="submit" class="cm-btn cm-btn-primary" id="cmRemarkSubmit"><i class="bi bi-plus-circle"></i> Create Remark</button></form>
    </div>
</div>
<div class="offcanvas offcanvas-end cm-offcanvas" tabindex="-1" id="cmIssuesSlider" aria-labelledby="cmIssuesTitle">

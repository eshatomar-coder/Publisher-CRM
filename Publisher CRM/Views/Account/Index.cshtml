                <i class="bi bi-bookmark-fill"></i><span class="cm-save-text">Save Filter</span>
            </button>
            <button class="cm-clear" type="button" id="cmClearFilters">Clear</button>
        </div>

        <div class="cm-tabs" id="cmTabs" role="tablist" aria-label="Customer account views">
            <button type="button" class="cm-tab active" data-tab="All" role="tab" aria-selected="true">
                All Accounts <span class="cm-tab-count" id="cmCountAll">0</span>
            </button>
            <button type="button" class="cm-tab" data-tab="Activation" role="tab" aria-selected="false">
                Send for Activation <span class="cm-tab-count" id="cmCountActivation">0</span>
            </button>
            <button type="button" class="cm-tab" data-tab="Approval" role="tab" aria-selected="false">
                Pending Approval <span class="cm-tab-count" id="cmCountApproval">0</span>
            </button>
        </div>

        <div class="cm-toolbar-end">
            <button type="button" class="cm-btn cm-btn-danger cm-hidden" id="cmDeleteSelected" aria-live="polite" title="Delete selected customers">
                <i class="bi bi-trash3"></i><span>Delete (<span id="cmSelectedCount">0</span>)</span>
            </button>

            <button class="cm-btn" id="cmExportBtn" type="button">
                <i class="bi bi-download"></i> Export <i class="bi bi-chevron-down cm-caret"></i>
            </button>

            <button class="cm-btn" type="button" data-bs-toggle="modal" data-bs-target="#cmImportModal">
                <i class="bi bi-cloud-arrow-up-fill"></i> Upload File
            </button>

            <div class="dropdown cm-hero-dropdown">
                <button class="cm-btn" type="button" id="cmHeroViewMenu" data-bs-toggle="dropdown" aria-expanded="false" aria-label="View options">
                    <i class="bi bi-eye"></i> View <i class="bi bi-chevron-down cm-caret"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end cm-view-dropdown" aria-labelledby="cmHeroViewMenu">
                    <li><button class="dropdown-item" type="button" id="cmViewListMenu"><i class="bi bi-list-ul"></i> Table view</button></li>
                    <li><button class="dropdown-item" type="button" id="cmViewGridMenu"><i class="bi bi-grid-3x3-gap"></i> Card view</button></li>
                    <li><button class="dropdown-item" type="button" id="cmViewSearchMenu"><i class="bi bi-search"></i> Search customers</button></li>
                    <li><button class="dropdown-item" type="button" id="cmViewReloadMenu"><i class="bi bi-arrow-clockwise"></i> Refresh accounts</button></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><button class="dropdown-item" type="button" id="btnSyncBc"><i class="bi bi-arrow-repeat"></i> Sync BC</button></li>
                </ul>
            </div>

            <a class="cm-btn cm-btn-primary" href="@Url.Action("Create", "Account")">
                <i class="bi bi-plus-lg"></i> Create Customer
            </a>

            @* Kept in DOM for existing JS bindings (search popover opened via View -> Search customers) *@
            <div class="cm-inline-search" id="cmInlineSearch">
                <button type="button" class="cm-small-icon cm-hidden" id="cmSearchToggle" aria-label="Search customers" aria-expanded="false" aria-controls="cmSearchFloating">
                    <i class="bi bi-search"></i>
                </button>
                <div class="cm-search-floating" id="cmSearchFloating">
                    <label class="cm-search-box" aria-label="Search current view">
                        <i class="bi bi-search"></i>
                        <input type="search" id="cmLocalSearch" placeholder="Search customers..." autocomplete="off" />
                    </label>
                </div>
            </div>
            <button class="cm-small-icon cm-hidden" id="cmReload" type="button" aria-label="Refresh accounts">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
            <div class="cm-view-switch cm-hidden" role="group" aria-label="Display mode">
                <button type="button" id="cmTableMode" class="cm-view-btn active" data-mode="table"></button>
                <button type="button" id="cmCardMode" class="cm-view-btn" data-mode="grid"></button>
            </div>
        </div>
    </div>

    <div class="cm-shell filters-open" id="cmShell">
        <div class="cm-filter-scrim" id="cmFilterScrim" aria-hidden="true"></div>
        <aside class="cm-filters" id="cmFilterPanel" aria-label="Account filters">
            <div class="cm-filter-head"><strong>Search filters...</strong><button type="button" id="cmCloseFilters" class="cm-icon-plain" aria-label="Close filters"><i class="bi bi-x-lg"></i></button></div>
            <label class="cm-filter-search"><i class="bi bi-search"></i><input id="cmFilterFind" placeholder="Find filter..." type="search" autocomplete="off" /></label>
            <div class="cm-filter-body" id="cmFilterBody">
                <details class="cm-filter-section" data-filter-section="type" id="cmCustomerTypeSection" open>
                    <summary>Customer Type <i class="bi bi-chevron-up"></i></summary>
                    <div class="cm-filter-options">
                        <label class="cm-choice"><input type="checkbox" name="cmCustomerType" value="Customer" />Customer</label>
                        <label class="cm-choice"><input type="checkbox" name="cmCustomerType" value="Prospect" />Prospect</label>
                        <label class="cm-choice"><input type="checkbox" name="cmCustomerType" value="Partner" />Partner</label>
                        <label class="cm-choice"><input type="checkbox" name="cmCustomerType" value="Other" />Other</label>
                        <div class="cm-filter-note" id="cmCustomerTypeHelp" hidden>Customer Type requires the customerType field in GetAccountsList.</div>
                    </div>
                </details>
                <details class="cm-filter-section" data-filter-section="status" open>
                    <summary> Status <i class="bi bi-chevron-up"></i></summary>
                    <div class="cm-filter-options">
                        <label class="cm-choice"><input type="checkbox" name="cmStatus" value="Potential" /><span class="cm-dot" style="background:#13be65"></span>Potential</label>
                        <label class="cm-choice"><input type="checkbox" name="cmStatus" value="Active" /><span class="cm-dot" style="background:#ff9500"></span>Active</label>
                        <label class="cm-choice"><input type="checkbox" name="cmStatus" value="In-Active" /><span class="cm-dot" style="background:#0764fa"></span>In-Active</label>
                        <label class="cm-choice"><input type="checkbox" name="cmStatus" value="Dormant" /><span class="cm-dot" style="background:#7247e9"></span>Dormant</label>
                        <label class="cm-choice"><input type="checkbox" name="cmStatus" value="New" /><span class="cm-dot" style="background:#ff3953"></span>New</label>
                        <label class="cm-choice"><input type="checkbox" name="cmStatus" value="Closed" /><span class="cm-dot" style="background:#9aa9c9"></span>Closed</label>
                    </div>
                </details>
                <details class="cm-filter-section" data-filter-section="owner">
                    <summary>Owner <i class="bi bi-chevron-up"></i></summary>
                    <div class="cm-filter-options" id="cmOwnerOptions"><span class="cm-ellipsis" style="font-size:11px">Loading owners...</span></div>
                </details>
                <details class="cm-filter-section" data-filter-section="date" id="cmCreatedDateSection">
                    <summary>Created Date <i class="bi bi-chevron-up"></i></summary>
                    <label class="cm-choice" for="cmStartDate">From</label><input id="cmStartDate" type="date" class="cm-date" />
                    <label class="cm-choice mt-2" for="cmEndDate">To</label><input id="cmEndDate" type="date" class="cm-date" />
                    <div class="cm-filter-note mt-2" id="cmCreatedDateHelp" hidden>Created Date requires a createdAt field in GetAccountsList.</div>
                </details>
                <details class="cm-filter-section" data-filter-section="accountstatus" open>
                    <summary>Account Status <i class="bi bi-chevron-up"></i></summary>
                    <div class="cm-filter-options">
                        <label class="cm-choice"><input type="checkbox" name="cmAccountStatus" value="Hold" /><span class="cm-dot" style="background:#f03c54"></span>Hold</label>
                        <label class="cm-choice"><input type="checkbox" name="cmAccountStatus" value="Pending" /><span class="cm-dot" style="background:#0754f8"></span>Pending</label>
                        <label class="cm-choice"><input type="checkbox" name="cmAccountStatus" value="Approved" /><span class="cm-dot" style="background:#0fc071"></span>Approved</label>
                    </div>
                </details>
                <details class="cm-filter-section" data-filter-section="source">
                    <summary>Source <i class="bi bi-chevron-up"></i></summary>
                    <div class="cm-filter-options" id="cmSourceOptions"><span class="cm-ellipsis" style="font-size:11px">Loading sources...</span></div>
                </details>
            </div>
            <div class="cm-filter-footer">
                <button type="button" class="cm-btn" id="cmFilterReset"><i class="bi bi-arrow-counterclockwise"></i> Reset</button>
                <button type="button" class="cm-btn cm-btn-primary" id="cmFilterApply">Apply</button>
            </div>
        </aside>

        <section class="cm-results" id="cmResults" data-mode="auto" aria-label="Accounts list">
            <h2 class="cm-visually-hidden" id="cmCurrentTitle">All Accounts</h2>
            <span id="cmViewCaption" class="cm-caption visually-hidden">Manage customer status, business, enquiries, and account activity.</span>
            <div id="cmDataError" class="cm-notice cm-hidden" role="alert"></div>
            <div class="cm-table-scroller" id="cmTableScroll">
                <table id="cmTable" class="table" aria-label="Customer accounts"></table>
            </div>
            <div class="cm-card-list" id="cmCardList" aria-live="polite"></div>
            <div id="cmEmptyState" class="cm-empty cm-hidden">No accounts match this view and your filters.</div>
            <div class="cm-footer">
                <span id="cmShowing" aria-live="polite">Loading accounts...</span>
                <div class="cm-pagination" id="cmPagination" aria-label="Accounts pagination"></div>
                <label class="d-flex align-items-center gap-2 m-0">Show: <select id="cmPageSize" class="form-select form-select-sm" style="width:65px; border-color:var(--cm-line); font-size:11.5px;"><option value="100" selected>100</option><option value="200">200</option><option value="300">300</option><option value="400">400</option><option value="500">500</option></select></label>
            </div>
        </section>
    </div>

    <!-- Single floating actions menu for desktop table and mobile cards. -->
    <div class="cm-action-popover" id="cmActionPopover" role="menu" aria-label="Account actions" hidden></div>
    <div class="cm-toast" id="cmToast" role="status" aria-live="polite"></div>
</div>

@* Bootstrap Offcanvas: real loading and saving require the four endpoints listed in integration notes. *@

@{
    ViewData["Title"] = "Customer Management";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

<style>
    /* SalesONE / Account / Index: Consolidated Single-Topbar Layout */
    .cm-page {
        --cm-blue: #0754f8;
        --cm-ink: #10224d;
        --cm-muted: #7380a0;
        --cm-line: #e4eafb;
        --cm-pale: #f4f7ff;
        --cm-white: #fff;
        box-sizing: border-box;
        height: calc(100dvh - 64px);
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 12px 16px 12px;
        color: var(--cm-ink);
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        background: radial-gradient(ellipse 46% 22% at 49% 4%, #ebf0ff, transparent 100%), #f5f7ff;
    }

        .cm-page *, .cm-page *::before, .cm-page *::after {
            box-sizing: border-box;
        }

        .cm-page button, .cm-page input, .cm-page select, .cm-page textarea {
            font: inherit;
        }

        .cm-page button {
            cursor: pointer;
        }

            .cm-page button:focus-visible, .cm-page a:focus-visible, .cm-page input:focus-visible,
            .cm-page select:focus-visible, .cm-page summary:focus-visible {
                outline: 3px solid #93b6ff;
                outline-offset: 2px;
            }

    .cm-hidden {
        display: none !important;
    }

    .cm-visually-hidden, .cm-caption.visually-hidden {
        position: absolute !important;
        width: 1px !important;
        height: 1px !important;
        padding: 0 !important;
        margin: -1px !important;
        overflow: hidden !important;
        clip: rect(0, 0, 0, 0) !important;
        white-space: nowrap !important;
        border: 0 !important;
    }

    /* ================= SINGLE UNIFIED TOP BAR ================= */
    .cm-toolbar {
        flex: 0 0 auto;
        position: relative;
        z-index: 30;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0;
        min-height: 54px;
        padding: 6px 12px;
        background: #fff;
        border: 1px solid #e6ecfa;
        border-radius: 14px;
        box-shadow: 0 3px 14px rgba(24, 56, 130, .05);
        overflow: visible;
    }

    .cm-left-tools {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 6px;
        padding-right: 14px;
        margin-right: 14px;
        border-right: 1px solid #ebeffb;
    }

    .cm-btn {
        min-height: 36px;
        border: 1px solid #e4ebfc;
        background: #fff;
        color: #152b57;
        border-radius: 10px;
        padding: 6px 11px;
        font-size: 12px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none !important;
        transition: background .16s, border-color .16s, box-shadow .16s, color .16s;
        white-space: nowrap;
        line-height: 1.1;
    }

        .cm-btn:hover {
            background: #f2f6ff;
            border-color: #c7d8ff;
            color: #0754f8;
        }

        .cm-btn[disabled] {
            opacity: .55;
            pointer-events: none;
        }

        .cm-btn .cm-caret {
            font-size: 10px;
            opacity: .75;
            margin-left: -1px;
        }

    .cm-filter-trigger {
        background: #eef3ff;
        border-color: #dde7ff;
    }

    .cm-btn-quiet {
        background: #f5f7ff;
        border-color: #e7edfc;
    }

    .cm-btn-primary {
        color: #fff !important;
        border-color: #0754f8;
        background: #0754f8;
        padding: 7px 14px;
        min-height: 37px;
        box-shadow: 0 4px 12px rgba(7, 84, 248, .22);
    }

        .cm-btn-primary:hover {
            background: #0040dd;
            border-color: #0040dd;
            color: #fff !important;
        }

    .cm-btn-danger {
        border-color: #ffcad1;
        background: #fff0f2;
        color: #ad2a41;
    }

        .cm-btn-danger:hover {
            border-color: #ee9faa;
            background: #ffe2e7;
            color: #9e1730;
        }

    .cm-count {
        border-radius: 999px;
        background: #0754f8;
        color: #fff;
        font-size: 10px;
        font-weight: 800;
        padding: 2px 6px;
        min-width: 19px;
        text-align: center;
        line-height: 1.2;
    }

    .cm-clear {
        padding: 6px 5px;
        background: transparent;
        border: 0;
        color: #0754f8;
        font-size: 12px;
        font-weight: 750;
        white-space: nowrap;
    }

        .cm-clear:hover {
            text-decoration: underline;
        }

    /* Tabs inside single top bar */
    .cm-tabs {
        flex: 1 1 auto;
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 16px;
        overflow-x: auto;
        scrollbar-width: none;
    }

        .cm-tabs::-webkit-scrollbar {
            display: none;
        }

    .cm-tab {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        height: 40px;
        padding: 0 4px;
        color: #50628d;
        background: transparent;
        border: 0;
        border-bottom: 2.5px solid transparent;
        font-size: 12.5px;
        font-weight: 700;
        white-space: nowrap;
        transition: color .15s, border-color .15s;
    }

        .cm-tab:hover {
            color: #0754f8;
        }

        .cm-tab.active {
            color: #0754f8;
            border-bottom-color: #0754f8;
            font-weight: 800;
        }

    .cm-tab-count {
        background: #eaeffb;
        color: #4a5d87;
        padding: 2px 7px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 800;
        line-height: 1.3;
    }

    .cm-tab.active .cm-tab-count {
        background: #0754f8;
        color: #fff;
    }

    /* Right action buttons inside single top bar */
    .cm-toolbar-end {
        flex: 0 0 auto;
        position: relative;
        display: flex;
        align-items: center;
        gap: 7px;
        padding-left: 14px;
        margin-left: 12px;
        border-left: 1px solid #ebeffb;
    }

    .cm-hero-dropdown {
        position: relative;
    }

    .cm-view-dropdown {
        display: none;
        min-width: 180px !important;
        padding: 6px;
        border: 1px solid #e0e9fc;
        border-radius: 12px;
        box-shadow: 0 14px 30px rgba(20, 44, 93, .16);
        z-index: 50;
    }

    .cm-hero-dropdown .cm-view-dropdown.show {
        display: block;
    }

    .cm-view-dropdown .dropdown-item {
        display: flex;
        gap: 10px;
        align-items: center;
        padding: 8px 10px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        color: #1b315c;
    }

        .cm-view-dropdown .dropdown-item:hover {
            color: #0754f8;
            background: #f1f5ff;
        }

    /* Floating search box triggered from View -> Search customers */
    .cm-inline-search {
        position: static;
    }

    .cm-search-floating {
        display: none;
        position: absolute;
        right: 0;
        top: calc(100% + 10px);
        z-index: 45;
        width: 260px;
        padding: 6px;
        background: #fff;
        border: 1px solid #dfe7fb;
        border-radius: 12px;
        box-shadow: 0 12px 28px rgba(26, 45, 89, .18);
    }

    .cm-inline-search.is-open .cm-search-floating {
        display: block;
    }

    .cm-search-box {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 0 10px;
        border: 1px solid #e0e8fa;
        border-radius: 9px;
        background: #f9fbff;
        color: #7d8cb0;
    }

        .cm-search-box input {
            width: 100%;
            min-width: 0;
            height: 34px;
            background: transparent;
            border: 0;
            outline: none;
            font-size: 12px;
            font-weight: 600;
            color: #162a57;
        }

    /* ================= MAIN SHELL: FILTERS + RESULTS ================= */
    .cm-shell {
        flex: 1 1 auto;
        min-height: 0;
        min-width: 0;
        display: flex;
        align-items: stretch;
        gap: 12px;
    }

    .cm-filter-scrim {
        display: none;
    }

    .cm-filters {
        flex: 0 0 242px;
        width: 242px;
        height: 100%;
        min-height: 0;
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid #e5ebfb;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(25, 57, 132, .05);
        overflow: hidden;
    }

    .cm-shell:not(.filters-open) .cm-filters {
        display: none;
    }

    .cm-filter-head {
        display: none;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px 6px;
        flex: 0 0 auto;
    }

        .cm-filter-head strong {
            font-size: 13.5px;
            font-weight: 800;
        }

    .cm-icon-plain {
        border: 0;
        background: #f1f4ff;
        border-radius: 9px;
        width: 30px;
        height: 30px;
        display: inline-grid;
        place-items: center;
        color: #52658d;
    }

    .cm-filter-search {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 10px 13px 6px;
        padding: 8px 10px;
        border: 1px solid #e7edfb;
        border-radius: 10px;
        background: #f8faff;
        color: #7082ad;
    }

        .cm-filter-search input {
            border: 0;
            outline: 0;
            background: transparent;
            min-width: 0;
            flex: 1;
            width: 100%;
            font-size: 12px;
            color: #273b64;
        }

    .cm-filter-body {
        flex: 1 1 auto;
        min-height: 0;
        overflow: auto;
        padding: 2px 14px 10px;
        scrollbar-width: thin;
    }

    .cm-filter-section {
        border-bottom: 1px solid #f0f3fc;
        padding: 10px 0;
    }

        .cm-filter-section:last-child {
            border-bottom: 0;
        }

        .cm-filter-section.is-disabled {
            opacity: .62;
        }

            .cm-filter-section.is-disabled .cm-choice,
            .cm-filter-section.is-disabled .cm-choice input {
                cursor: not-allowed;
            }

        .cm-filter-section summary {
            display: flex;
            align-items: center;
            justify-content: space-between;
            list-style: none;
            cursor: pointer;
            color: #102250;
            font-size: 12.5px;
            font-weight: 800;
            margin-bottom: 9px;
        }

            .cm-filter-section summary::-webkit-details-marker {
                display: none;
            }

            .cm-filter-section summary i {
                font-size: 11px;
                color: #6a7ca5;
                transition: transform .2s;
            }

        .cm-filter-section:not([open]) summary i {
            transform: rotate(180deg);
        }

    .cm-filter-options {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .cm-choice {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 12px;
        font-weight: 550;
        color: #263b64;
        min-height: 20px;
        cursor: pointer;
    }

        .cm-choice input {
            width: 15px;
            height: 15px;
            accent-color: #0754f8;
            margin: 0;
            flex: none;
        }

    .cm-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        flex: none;
    }

    .cm-date {
        width: 100%;
        max-width: 100%;
        padding: 7px 9px;
        border: 1px solid #e2e9fc;
        border-radius: 8px;
        font-size: 12px;
        color: #1e335c;
    }

    .cm-disabled-date {
        background: #f1f4fb !important;
        cursor: not-allowed;
    }

    .cm-filter-note {
        color: #7282a2;
        font-size: 10px;
        line-height: 1.45;
        background: #f6f8ff;
        border-radius: 8px;
        padding: 7px 9px;
    }

    .cm-filter-footer {
        flex: 0 0 auto;
        display: flex;
        gap: 8px;
        padding: 10px 12px;
        background: #fff;
        border-top: 1px solid #edf1fc;
    }

        .cm-filter-footer .cm-btn {
            flex: 1;
            min-width: 0;
            min-height: 38px;
            padding: 8px 10px;
        }

    /* ================= RESULTS CARD & TABLE ================= */
    .cm-results {
        flex: 1 1 auto;
        min-width: 0;
        height: 100%;
        min-height: 0;
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid #e5ebfb;
        border-radius: 14px;
        box-shadow: 0 4px 16px rgba(33, 65, 153, .05);
        overflow: hidden;
    }

    .cm-notice {
        margin: 10px 14px 0;
        padding: 9px 12px;
        border-radius: 10px;
        background: #fff6df;
        color: #805700;
        font-size: 11px;
        font-weight: 700;
        border: 1px solid #ffe9af;
    }

    .cm-table-scroller {
        flex: 1 1 auto;
        min-height: 0;
        height: 0;
        width: 100%;
        overflow: auto;
        overscroll-behavior: contain;
        position: relative;
        isolation: isolate;
        scrollbar-width: thin;
    }

    .cm-page .cm-table-scroller .table > :not(caption) > * > * {
        box-shadow: none;
    }

    #cmTable {
        width: 100% !important;
        min-width: 1140px !important;
        margin: 0 !important;
        border-collapse: separate !important;
        border-spacing: 0 !important;
        table-layout: fixed;
        font-size: 12px;
    }

        #cmTable thead th {
            position: sticky;
            top: 0;
            z-index: 5;
            height: 40px !important;
            padding: 8px 10px !important;
            background: #f3f6ff;
            color: #293c69;
            font-size: 11.2px;
            font-weight: 800;
            text-align: left;
            letter-spacing: -.01em;
            border-top: 0;
            border-bottom: 1px solid #e3e9fa;
            border-right: 0;
            white-space: nowrap;
            vertical-align: middle;
        }

            /* Reserve right padding for DataTables sort icons so header text never overlaps */
            #cmTable thead th.sorting,
            #cmTable thead th.sorting_asc,
            #cmTable thead th.sorting_desc {
                padding-right: 24px !important;
            }

                #cmTable thead th.sorting::before, #cmTable thead th.sorting::after,
                #cmTable thead th.sorting_asc::before, #cmTable thead th.sorting_asc::after,
                #cmTable thead th.sorting_desc::before, #cmTable thead th.sorting_desc::after {
                    opacity: .35;
                    right: 7px !important;
                }

        #cmTable tbody td {
            height: 36px !important;
            padding: 6px 10px !important;
            background: #fff;
            border-right: 0;
            border-bottom: 1px solid #eff2fa;
            vertical-align: middle;
            color: #182b53;
            font-size: 12px;
            font-weight: 600;
            line-height: 1.2;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #cmTable tbody tr {
            cursor: pointer;
        }

            #cmTable tbody tr:hover td {
                background: #f6f9ff;
            }

        /* Sticky Left Columns */
        #cmTable th.cm-col-check, #cmTable td.cm-col-check {
            width: 42px !important;
            min-width: 42px !important;
            max-width: 42px !important;
            text-align: center;
            position: sticky;
            left: 0;
            z-index: 7;
        }

        #cmTable th.cm-col-status, #cmTable td.cm-col-status {
            width: 142px !important;
            min-width: 142px !important;
            max-width: 142px !important;
            position: sticky;
            left: 42px;
            z-index: 7;
        }

        #cmTable th.cm-col-name, #cmTable td.cm-col-name {
            width: 240px !important;
            min-width: 240px !important;
            max-width: 240px !important;
            position: sticky;
            left: 184px;
            z-index: 7;
        }

        #cmTable th.cm-col-id, #cmTable td.cm-col-id {
            width: 58px !important;
            min-width: 58px !important;
            max-width: 58px !important;
            text-align: center;
        }

        /* Prevent 12 Month Business column from squeezing */
        #cmTable th.text-end, #cmTable td.text-end {
            width: 160px !important;
            min-width: 160px !important;
            text-align: right;
        }

        /* Sticky Right Actions Column */
        #cmTable th.cm-col-actions, #cmTable td.cm-col-actions {
            width: 72px !important;
            min-width: 72px !important;
            max-width: 72px !important;
            position: sticky;
            right: 0;
            z-index: 8;
            text-align: center;
            border-left: 1px solid #edf1fb;
            overflow: visible;
        }

        #cmTable thead th.cm-col-check,
        #cmTable thead th.cm-col-status,
        #cmTable thead th.cm-col-name,
        #cmTable thead th.cm-col-actions {
            z-index: 12;
            background: #f3f6ff;
        }

        #cmTable input[type="checkbox"] {
            margin: 0;
            width: 15px;
            height: 15px;
            accent-color: #0754f8;
            vertical-align: middle;
        }

        #cmTable .cm-name {
            display: inline-block;
            max-width: 100%;
            color: #0754f8;
            text-decoration: none;
            font-weight: 780;
            font-size: 12px;
            line-height: 1.2;
            letter-spacing: -.015em;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            vertical-align: middle;
        }

            #cmTable .cm-name:hover {
                text-decoration: underline;
            }

    .cm-status-cell {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cm-bookmark {
        color: #ff8a00;
        font-size: 14px;
        flex: none;
    }

    .cm-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 10.8px;
        line-height: 1.1;
        min-width: 72px;
        font-weight: 760;
        white-space: nowrap;
        border: 1px solid transparent;
    }

    .cm-pill-potential {
        background: #dff9e8;
        color: #047137;
    }

    .cm-pill-active {
        background: #fff1d8;
        color: #a85c00;
    }

    .cm-pill-inactive {
        background: #dcf0ff;
        color: #0564ce;
    }

    .cm-pill-dormant {
        background: #e9e0ff;
        color: #673bd1;
    }

    .cm-pill-new {
        background: #ffe5e9;
        color: #cf233e;
    }

    .cm-pill-closed {
        background: #e8edf6;
        color: #425779;
    }

    .cm-pill-pending {
        background: #dfedff;
        color: #0754f8;
    }

    .cm-pill-approved {
        background: #d9f8e2;
        color: #09702e;
    }

    .cm-pill-hold {
        background: #ffe2e5;
        color: #ba1b31;
    }

    .cm-pill-draft {
        background: #fff2d6;
        color: #ae6100;
    }

    .cm-pill-review {
        background: #e5eaff;
        color: #3c4c9b;
    }

    .cm-ellipsis {
        color: #8d9cb9;
    }

    .cm-more {
        display: inline-grid;
        place-items: center;
        width: 36px;
        height: 26px;
        background: #f4f7ff;
        border: 1px solid #e3e9fc;
        border-radius: 9px;
        color: #18366a;
        font-size: 17px;
        line-height: 1;
        padding: 0;
    }

        .cm-more:hover, .cm-more[aria-expanded="true"] {
            color: #0754f8;
            background: #e9f0ff;
            border-color: #bcd1ff;
        }

    /* Floating Row Actions Menu */
    .cm-action-popover {
        position: fixed;
        width: 226px;
        z-index: 1080;
        padding: 7px;
        display: flex;
        flex-direction: column;
        border: 1px solid #dce6fc;
        border-radius: 13px;
        background: #fff;
        box-shadow: 0 16px 46px rgba(20, 44, 93, .22);
        max-height: min(70dvh, 440px);
        overflow: auto;
    }

        .cm-action-popover[hidden] {
            display: none !important;
        }

    .cm-menu-heading {
        padding: 9px 10px 10px;
        font-size: 11px;
        font-weight: 800;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: #233968;
        border-bottom: 1px solid #edf2fb;
        margin-bottom: 5px;
    }

    .cm-menu-divider {
        border-top: 1px solid #edf2fb;
        margin: 4px 0;
    }

    .cm-action {
        text-decoration: none !important;
        color: #23457a;
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
        width: 100%;
        border: 0;
        border-radius: 8px;
        background: transparent;
        padding: 9px 10px;
        min-height: 36px;
        gap: 10px;
        text-align: left;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

        .cm-action:hover {
            background: #edf4ff;
            color: #0754f8;
        }

        .cm-action i {
            width: 17px;
            text-align: center;
            font-size: 14px;
        }

    .cm-action-label {
        display: block;
        flex: 1;
    }

    .cm-action-count {
        margin-left: auto;
        font-size: 10px;
        border-radius: 6px;
        background: #e6ecfb;
        padding: 2px 6px;
    }

    .cm-action-send {
        color: #0754f8;
    }

    /* ================= CARD VIEW ================= */
    .cm-card-list {
        display: none;
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        align-content: start;
        gap: 12px;
        padding: 12px;
        background: #f9fbff;
    }

    .cm-results[data-mode="grid"] .cm-table-scroller {
        display: none;
    }

    .cm-results[data-mode="grid"] .cm-card-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(265px, 1fr));
    }

    .cm-results[data-mode="table"] .cm-card-list {
        display: none;
    }

    .cm-card {
        border: 1px solid #e2eafb;

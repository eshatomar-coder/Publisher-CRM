<div class="modal fade" id="cmImportModal" tabindex="-1" aria-labelledby="cmImportTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border:0;border-radius:17px;overflow:hidden">
            <div class="modal-header" style="background:#f5f8ff"><h2 class="modal-title fs-6 fw-bold" id="cmImportTitle"><i class="bi bi-cloud-arrow-up-fill text-primary"></i> Import Accounts (CSV)</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <form action="@Url.Action("ImportCsv", "Account")" method="post" enctype="multipart/form-data">
                <div class="modal-body"><p class="small text-muted">Select a CSV file with headers matching your account import format.</p>@Html.AntiForgeryToken()<input type="file" name="file" class="form-control" accept=".csv,text/csv" required /></div>
                <div class="modal-footer"><button type="button" class="cm-btn" data-bs-dismiss="modal">Cancel</button><button class="cm-btn cm-btn-primary" type="submit"><i class="bi bi-upload"></i> Start Upload</button></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        (function () {
            'use strict';
            const E = {
                list: '@Url.Action("GetAccountsList", "Account")',
                sync: '@Url.Action("TriggerBcSync", "Account")',
                deleteBulk: '@Url.Action("DeleteBulk", "Account")',
                edit: '@Url.Action("Edit", "Account")',
                accountCreate: '@Url.Action("Create", "Account")',
                salesCall: '@Url.Action("Create", "SalesCall")',
                enquiry: '@Url.Action("Create", "Lead")',
                order: '@Url.Action("Create", "OrderManagement")',
                // NEW SERVER ENDPOINTS: implement as described in Account_Index_Integration_Guide.md
                remarksGet: '@Url.Action("GetAccountRemarks", "Account")',
                remarkAdd: '@Url.Action("AddAccountRemark", "Account")',
                issuesGet: '@Url.Action("GetPendingAccountIssues", "Account")',
                issueAdd: '@Url.Action("AddAccountIssue", "Account")'
            };
            const root = document.getElementById('cmPage');
            const shell = document.getElementById('cmShell');
            const results = document.getElementById('cmResults');
            const antiforgery = document.querySelector('#cmAntiforgery input[name="__RequestVerificationToken"]')?.value || '';
            const numberFmt = new Intl.NumberFormat('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const allStatuses = ['Potential', 'Active', 'In-Active', 'Dormant', 'New', 'Closed'];
            const state = { rows: [], tab: 'All', table: null, selected: new Set(), panelAccountId: null, filter: { status: [], accountStatus: [], owner: [], source: [], type: [], start: '', end: '' }, currentMode: 'auto', busy: false };
            const $table = $('#cmTable');
            let searchTimer;
            let toastTimer;

            function s(v) { return v == null ? '' : String(v); }
            function esc(v) { return s(v).replace(/[&<>"']/g, x => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[x])); }
            function attr(v) { return esc(v); }
            function first(obj, keys, fallback = '') { for (const key of keys) if (obj[key] !== undefined && obj[key] !== null && s(obj[key]).trim() !== '') return obj[key]; return fallback; }
            function txt(obj, keys, fallback = '') { return s(first(obj, keys, fallback)).trim(); }
            function amount(v) { const n = Number(String(v ?? 0).replace(/[,₹]/g, '')); return Number.isFinite(n) ? n : 0; }
            function count(v) { const n = Number(v); return Number.isFinite(n) && n > 0 ? Math.floor(n) : 0; }
            function truthy(v) { return v === true || v === 1 || ['1', 'true', 'yes'].includes(s(v).toLowerCase()); }
            function canonStatus(v) { const val = s(v).toLowerCase().replace(/[\s_-]/g, ''); const options = { potential: 'Potential', active: 'Active', inactive: 'In-Active', dormant: 'Dormant', new: 'New', closed: 'Closed' }; return options[val] || 'Potential'; }
            function canonAccountStatus(v) { const val = s(v).trim().toLowerCase(); if (val === 'hold') return 'Hold'; if (val === 'approved') return 'Approved'; return 'Pending'; }
            function toDate(v) { if (!v) return null; if (typeof v === 'string' && /^\d{4}-\d{2}-\d{2}T/.test(v) && !v.endsWith('Z') && !/[+-]\d\d:\d\d$/.test(v)) { v += 'Z'; } const d = new Date(v); return Number.isFinite(d.getTime()) ? d : null; }
            function dateLabel(v) { const d = toDate(v); return d ? new Intl.DateTimeFormat('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }).format(d) : '—'; }
            function toDateYmd(v) { const d = toDate(v); return d ? `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}` : ''; }
            function urlWithId(url, id, parameter = 'accountId') { const joiner = url.includes('?') ? '&' : '?'; return url + joiner + encodeURIComponent(parameter) + '=' + encodeURIComponent(s(id)); }
            function editUrl(row) { return E.edit.replace(/\/$/, '') + '/' + encodeURIComponent(row.accountId); }
            function normalizeRow(raw) {
                const accountId = first(raw, ['accountId', 'AccountId', 'id', 'Id']);
                const source = txt(raw, ['source', 'Source']);
                const status = canonStatus(first(raw, ['status', 'Status'], 'Potential'));
                const accountStatusRaw = txt(raw, ['accountStatus', 'AccountStatus'], 'Pending');
                const activationRaw = txt(raw, ['activationStatus', 'ActivationStatus']);
                const sent = truthy(first(raw, ['activationRequested', 'ActivationRequested', 'sentForActivation', 'SentForActivation', 'isSentForActivation', 'IsSentForActivation'], false))
                    || Boolean(first(raw, ['activationSentAtUtc', 'ActivationSentAtUtc', 'approvalSubmittedAtUtc', 'ApprovalSubmittedAtUtc']))
                    || accountStatusRaw.toLowerCase() === 'pending approval'
                    || ['submitted', 'sent', 'pending approval'].includes(activationRaw.toLowerCase());
                // Draft per business rule: any additional business/address detail was filled.
                // Prefer server-calculated ActivationStatus or HasExtendedDetails when available.
                const extendedKeys = ['address', 'addressLine1', 'address1', 'address2', 'city', 'state', 'pinCode', 'postalCode', 'gstNumber', 'gstNo', 'panNumber', 'creditLimit', 'paymentTerms', 'businessType', 'companyType', 'country', 'website', 'taxRegistrationNumber'];
                const extended = extendedKeys.some(key => raw[key] !== undefined && raw[key] !== null && s(raw[key]).trim() !== '' && s(raw[key]).trim() !== '0');
                const hasDetails = truthy(first(raw, ['hasExtendedDetails', 'HasExtendedDetails'], false)) || extended;
                const readiness = hasDetails || activationRaw.toLowerCase() === 'draft' ? 'Draft' : 'Pending';
                return {
                    accountId, accountName: txt(raw, ['accountName', 'AccountName', 'customerName', 'CustomerName'], 'Untitled Account'), status,
                    accountOwner: txt(raw, ['accountOwner', 'AccountOwner', 'owner', 'Owner'], '—'), accountStatus: canonAccountStatus(accountStatusRaw),
                    accountStatusRaw, source: source || '—', twelveMonthBusiness: amount(first(raw, ['twelveMonthBusiness', 'TwelveMonthBusiness'], 0)),
                    contactName: txt(raw, ['contactName', 'ContactName'], '—'),
                    mobile: txt(raw, ['mobile', 'Mobile', 'phone', 'Phone', 'phoneNumber', 'PhoneNumber', 'mobileNumber', 'MobileNumber'], '—'),
                    email: txt(raw, ['email', 'Email', 'emailAddress', 'EmailAddress'], '—'),
                    customerType: txt(raw, ['customerType', 'CustomerType']), createdAt: first(raw, ['createdAtUtc', 'CreatedAtUtc', 'createdAt', 'CreatedAt', 'createdOn', 'CreatedOn']),
                    updatedAt: first(raw, ['updatedAtUtc', 'UpdatedAtUtc', 'lastUpdatedUtc', 'LastUpdatedUtc', 'modifiedAt', 'ModifiedAt', 'modifiedOn', 'ModifiedOn']),
                    activationSentAt: first(raw, ['activationSentAtUtc', 'ActivationSentAtUtc', 'approvalSubmittedAtUtc', 'ApprovalSubmittedAtUtc']),
                    sent, readiness, remarkCount: count(first(raw, ['remarkCount', 'RemarkCount'], 0)),
                    issueCount: count(first(raw, ['pendingIssueCount', 'PendingIssueCount', 'issueCount', 'IssueCount'], 0)),
                    salesCallCount: count(first(raw, ['salesCallCount', 'SalesCallCount'], 0)),
                    enquiryCount: count(first(raw, ['enquiryCount', 'EnquiryCount'], 0)),
                    orderCount: count(first(raw, ['orderCount', 'OrderCount'], 0))
                };
            }
            function viewRows() { if (state.tab === 'Activation') return state.rows.filter(r => r.status === 'Potential' && !r.sent); if (state.tab === 'Approval') return state.rows.filter(r => r.status === 'Potential' && r.sent); return state.rows; }
            function pills(name, type) { const key = type === 'status' ? ({ 'Potential': 'potential', 'Active': 'active', 'In-Active': 'inactive', 'Dormant': 'dormant', 'New': 'new', 'Closed': 'closed' }[name] || 'potential') : type === 'account' ? ({ 'Hold': 'hold', 'Pending': 'pending', 'Approved': 'approved' }[name] || 'pending') : (name === 'Draft' ? 'draft' : 'pending'); return `<span class="cm-pill cm-pill-${key}">${esc(name)}</span>`; }
            function statusDisplay(r) { return `<div class="cm-status-cell"><i class="bi bi-bookmark-fill cm-bookmark" aria-hidden="true"></i>${pills(r.status, 'status')}</div>`; }
            function nameDisplay(r) { return `<a class="cm-name" href="${attr(editUrl(r))}" title="Edit ${attr(r.accountName)}">${esc(r.accountName)}</a>`; }
            function emptyVal(v) { return s(v).trim() === '' || s(v) === '—' ? '<span class="cm-ellipsis">—</span>' : esc(v); }
            function currency(v) { return `₹${numberFmt.format(amount(v))}`; }
            function action(kind, label, icon, n, id) {
                return `<button class="cm-action" type="button" title="${attr(label)}" aria-label="${attr(label)} (${n})" data-cm-action="${kind}" data-id="${attr(id)}"><i class="bi bi-${icon}"></i><span class="cm-action-label">${esc(label)}</span><span class="cm-action-count">${count(n)}</span></button>`;
            }
            function actionLink(label, icon, n, id, url, kind = 'link') {
                return `<a class="cm-action" href="${attr(urlWithId(url, id))}" title="${attr(label)}" aria-label="${attr(label)} (${n})"><i class="bi bi-${icon}"></i><span class="cm-action-label">${esc(label)}</span><span class="cm-action-count">${count(n)}</span></a>`;
            }
            function sendLink(r) { return `<a class="cm-action cm-action-send cm-action-activate" href="${attr(urlWithId(E.accountCreate, r.accountId, 'id'))}" title="Send ${attr(r.accountName)} for activation"><i class="bi bi-send-fill"></i><span class="cm-action-label">Send for Activation</span></a>`; }
            function viewRequestLink(r) { return `<a class="cm-action cm-action-activate" href="${attr(editUrl(r))}" title="View submitted request"><i class="bi bi-eye"></i><span class="cm-action-label">View Request</span></a>`; }
            // Keeps the table compact and matches the ellipsis-only Actions column in the design.
            function actions(r) {
                return `<button type="button" class="cm-more" data-menu-id="${attr(r.accountId)}"
                                  aria-label="Actions for ${attr(r.accountName)}" aria-haspopup="menu"
                                  aria-controls="cmActionPopover" aria-expanded="false" title="Account actions">
                                  <i class="bi bi-three-dots" aria-hidden="true"></i></button>`;
            }
            function menuContents(r) {
                // Activation and approval views deliberately have only their view-specific action.
                if (state.tab === 'Activation') return `<div class="cm-menu-heading">${esc(r.accountName)}</div>${sendLink(r)}`;
                if (state.tab === 'Approval') return `<div class="cm-menu-heading">${esc(r.accountName)}</div>${viewRequestLink(r)}`;
                return `<div class="cm-menu-heading">${esc(r.accountName)}</div>
                                ${action('remarks', 'Remarks', 'chat-left-text', r.remarkCount, r.accountId)}
                                ${action('issues', 'Pending Issues', 'exclamation-circle', r.issueCount, r.accountId)}
                                ${actionLink('Sales Call', 'telephone', r.salesCallCount, r.accountId, E.salesCall)}
                                ${actionLink('Enquiry', 'clipboard2-check', r.enquiryCount, r.accountId, E.enquiry)}
                                ${r.status === 'Potential' ? (r.sent ? viewRequestLink(r) : sendLink(r)) : actionLink('Order', 'bag', r.orderCount, r.accountId, E.order)}
                                <div class="cm-menu-divider"></div>
                                <a class="cm-action" href="${attr(editUrl(r))}"><i class="bi bi-pencil-square"></i><span class="cm-action-label">Edit Customer</span></a>`;
            }

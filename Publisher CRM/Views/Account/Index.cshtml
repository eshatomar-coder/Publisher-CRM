                }
            });

            document.getElementById('cmPageSize').addEventListener('change', e => state.table?.page.len(Number(e.target.value)).draw());
            document.getElementById('cmPagination').addEventListener('click', e => { const btn = e.target.closest('[data-pg]'); if (btn && !btn.disabled) state.table?.page(Number(btn.dataset.pg)).draw('page'); });
            document.getElementById('cmExportBtn').addEventListener('click', exportCsv);
            document.getElementById('cmReload').addEventListener('click', () => loadRows(true));
            document.getElementById('cmDeleteSelected').addEventListener('click', async function () {
                const ids = [...state.selected].map(Number).filter(Number.isSafeInteger);
                if (!ids.length) return;
                if (!window.confirm(`Delete ${ids.length} selected account${ids.length === 1 ? '' : 's'}? This action cannot be undone.`)) return;
                const button = this; button.disabled = true;
                try {
                    const data = await request(E.deleteBulk, { type: 'POST', contentType: 'application/json', data: JSON.stringify(ids), dataType: 'json' });
                    if (data?.success !== true) throw new Error(data?.message || 'The server did not confirm deletion.');
                    state.selected.clear(); updateSelectionUI(); notify(data.message || 'Selected accounts deleted.'); await loadRows(true);
                } catch (e) { notify('Delete failed: ' + s(e?.responseJSON?.message || e?.responseJSON?.error || e?.message || 'Server error'), true); }
                finally { button.disabled = false; }
            });
            root.addEventListener('change', e => { const input = e.target.closest('.cm-row-checkbox'); if (input) { const id = s(input.dataset.id); if (input.checked) state.selected.add(id); else state.selected.delete(id); document.querySelectorAll('.cm-row-checkbox').forEach(cb => { if (cb.dataset.id === id) cb.checked = input.checked; }); renderFooter(); } });
            $table.on('change', '#cmSelectPage', function () { for (const row of tableRowsOnPage()) { const id = s(row.accountId); if (this.checked) state.selected.add(id); else state.selected.delete(id); } renderFooter(); });
            // Preserve the original full-row navigation without interfering with row actions.
            $table.on('click', 'tbody tr', function (e) {
                if ($(e.target).closest('a,button,input,label,select,textarea').length) return;
                const record = state.table?.row(this).data(); if (record) window.location.assign(editUrl(record));
            });
            document.getElementById('cmCardList').addEventListener('click', e => {
                if (e.target.closest('a,button,input,label,select,textarea')) return;
                const card = e.target.closest('[data-account-id]');
                const record = card && panelAccount(card.dataset.accountId); if (record) window.location.assign(editUrl(record));
            });
            root.addEventListener('click', e => {
                const more = e.target.closest('[data-menu-id]');
                if (more) { e.preventDefault(); e.stopPropagation(); toggleActionPopover(more); return; }
                const btn = e.target.closest('[data-cm-action]');
                if (btn) { e.preventDefault(); closeActionPopover(); openPanel(btn.dataset.cmAction, btn.dataset.id); }
            });
            document.addEventListener('pointerdown', e => {
                if (!actionPopover.hidden && !actionPopover.contains(e.target) && !e.target.closest('[data-menu-id]')) closeActionPopover();
            });
            window.addEventListener('scroll', () => closeActionPopover(), true);
            window.addEventListener('resize', () => closeActionPopover());

            document.getElementById('cmRemarkForm').addEventListener('submit', e => { e.preventDefault(); savePanel('remarks'); });
            document.getElementById('cmIssueForm').addEventListener('submit', e => { e.preventDefault(); savePanel('issues'); });
            document.getElementById('btnSyncBc').addEventListener('click', async function () { this.disabled = true; const original = this.innerHTML; this.innerHTML = '<i class="bi bi-arrow-repeat"></i> Syncing...'; try { const data = antiforgery ? { __RequestVerificationToken: antiforgery } : {}; const res = await request(E.sync, { type: 'POST', data, dataType: 'json' }); if (res?.success === false) throw new Error(res?.error || res?.message || 'Sync did not complete.'); notify('Business Central sync completed.'); await loadRows(true); } catch (e) { notify('BC sync failed: ' + s(e?.responseJSON?.error || e?.responseJSON?.message || e?.message || 'Server error'), true); } finally { this.disabled = false; this.innerHTML = original; } });
            document.addEventListener('keydown', e => { if (e.key === 'Escape') { if (!actionPopover.hidden) { closeActionPopover(true); return; } if (window.matchMedia('(max-width:850px)').matches && shell.classList.contains('filters-open')) openFilters(false); } });
            // Restore saved filters without automatically opening the filter panel.
            try { const stored = JSON.parse(localStorage.getItem('salesone.savedAccountFilters.v1') || 'null'); if (stored && typeof stored === 'object') { for (const key of ['status', 'accountStatus', 'owner', 'source', 'type']) if (!Array.isArray(stored[key])) stored[key] = []; state.filter = { status: stored.status, accountStatus: stored.accountStatus, owner: stored.owner, source: stored.source, type: stored.type, start: stored.start || '', end: stored.end || '' }; } } catch (_) { /* use defaults */ }
            reflectFilters();
            const mobileQuery = window.matchMedia('(max-width:850px)');
            openFilters(!mobileQuery.matches); // DESKTOP: open; MOBILE: closed by default.
            mobileQuery.addEventListener('change', event => { closeActionPopover(); openFilters(!event.matches); if (state.currentMode === 'auto') setMode('auto'); });
            setMode('auto');
            loadRows();
        })();
    </script>
}

@model Publisher_CRM.Models.Complaints

@{
    ViewData["Title"] = "Create Complaint";
}

<style>
    body {
        background: radial-gradient(circle at top right, #1a2a42, #0d1627);
        background-color: #0d1627;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        color: #333;
    }

    .crm-card {
        background-color: #ffffff;
        border-radius: 16px;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
        border: none;
        overflow: hidden;
        margin-bottom: 2.5rem;
    }

    .crm-header {
        background: linear-gradient(135deg, #4b1a2e 0%, #a42c4b 100%); /* Slightly red theme for complaints */
        color: white;
        padding: 35px 40px;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 4px solid #ffb703;
    }

    .crm-header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .crm-header-icon {
        width: 60px;
        height: 60px;
        filter: drop-shadow(0px 8px 12px rgba(0,0,0,0.4));
    }

    .crm-header-text h2 {
        margin: 0;
        font-weight: 800;
        font-size: 2.2rem;
        letter-spacing: 0.5px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .crm-header-text p {
        margin: 5px 0 0 0;
        font-size: 0.95rem;
        opacity: 0.9;
    }

    .publisher-badge {
        background-color: #ffffff;
        color: #a42c4b;
        font-weight: 800;
        padding: 10px 25px;
        border-radius: 30px;
        font-size: 0.95rem;
        letter-spacing: 1px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }

    .form-section {
        background-color: #ffffff;
        padding: 30px;
        border-radius: 12px;
        margin-bottom: 30px;
        border: 1px solid #e9ecef;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

    .form-label {
        font-weight: 700;
        color: #343a40;
        font-size: 0.95rem;
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control, .form-select {
        background-color: #ffffff;
        border-radius: 8px;
        border: 2px solid #ced4da;
        padding: 12px 15px;
        color: #212529;
        font-weight: 500;
        transition: all 0.3s ease;
        width: 100%;
        box-sizing: border-box;
        margin-bottom: 15px;
    }

        .form-control:focus, .form-select:focus {
            border-color: #ffb703;
            box-shadow: 0 0 0 0.3rem rgba(255, 183, 3, 0.25);
            background-color: #fffdf7;
            outline: none;
        }

    .btn-save {
        background: linear-gradient(135deg, #ffb703 0%, #fb8500 100%);
        color: #ffffff;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
        font-weight: 800;
        font-size: 1.1rem;
        border: none;
        padding: 12px 35px;
        border-radius: 10px;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        cursor: pointer;
    }

        .btn-save:hover {
            background: linear-gradient(135deg, #fb8500 0%, #e85d04 100%);
            color: white;
            transform: translateY(-3px);
        }
</style>

<div class="container mt-5 mb-5">
    <div class="crm-card">
        <div class="crm-header">
            <div class="crm-header-left">
                <img src="https://raw.githubusercontent.com/microsoft/fluentui-emoji/main/assets/Megaphone/3D/megaphone_3d.png" alt="Complaint Icon" class="crm-header-icon" />
                <div class="crm-header-text">
                    <h2>Log New Complaint</h2>
                    <p>Register client feedback and issue resolution</p>
                </div>
            </div>
            <div class="publisher-badge">
                PUBLISHER CRM
            </div>
        </div>

        <form method="post" asp-action="Create" class="p-4">

            <div class="form-section">
                <div class="row">
                    <div class="col-md-4">
                        <label class="form-label">Account Name</label>
                        <input asp-for="AccountName" class="form-control" placeholder="Enter Account Name" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Complaints Owner</label>
                        <select asp-for="ComplaintsOwner" asp-items="@(ViewBag.UserList as SelectList ?? new SelectList(new List<SelectListItem>()))" class="form-select">
                            <option value="">-- Select Owner --</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="-None-">-None-</option>
                            <option value="Open">Open</option>
                            <option value="Closed">Closed</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Sales Call</label>
                        <input asp-for="SalesCall" class="form-control" placeholder="Call reference..." />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Sales Call Date</label>
                        <input asp-for="SalesCallDate" type="date" class="form-control" />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Complaint Remark</label>
                        <textarea asp-for="ComplaintRemark" class="form-control" rows="3" placeholder="Detail the complaint here..."></textarea>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label">Solution Remarks</label>
                        <textarea asp-for="SolutionRemarks" class="form-control" rows="2" placeholder="Resolution details..."></textarea>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Solution Date</label>
                        <input asp-for="SolutionDate" type="date" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="border-top pt-4 mt-2 d-flex">
                <button type="submit" class="btn-save px-5">Save Complaint</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-3 px-4 py-2" style="border-radius: 10px; font-weight: 600;">Cancel</a>
            </div>

        </form>
    </div>
</div>
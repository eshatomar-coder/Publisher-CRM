@using System.Text.Json
@model IEnumerable<Publisher_CRM.Models.BeatRoute>
@{
    ViewData["Title"] = "Beat Routes - Operations";
    var accountViewData = ViewBag.AccountViewData as IEnumerable<Publisher_CRM.Models.BeatRouteCustomer>;

    // Serialize data securely for the JavaScript engine
    var routeJson = JsonSerializer.Serialize(Model.Select(r => new
    {
        id = "BR-" + r.BeatRouteId,
        rawId = r.BeatRouteId,
        routeName = r.RouteName ?? "-",
        salesPerson = r.SalesPerson != null ? $"{r.SalesPerson.FirstName} {r.SalesPerson.LastName}" : "-",
        salesPersonId = r.SalesPersonId,
        customerIds = r.RouteCustomers.Select(c => c.AccountId).ToArray(),
        customersList = r.RouteCustomers.Select(c => c.Customer?.AccountName ?? "Unknown").ToArray()
    }));

    var accountJson = JsonSerializer.Serialize((accountViewData ?? Enumerable.Empty<Publisher_CRM.Models.BeatRouteCustomer>()).Select(a => new
    {
        customerId = "CUST-" + a.AccountId,
        customerName = a.Customer?.AccountName ?? "-",
        routeId = "BR-" + a.BeatRouteId,
        routeName = a.BeatRoute?.RouteName ?? "-",
        salesPerson = a.BeatRoute?.SalesPerson != null ? $"{a.BeatRoute.SalesPerson.FirstName} {a.BeatRoute.SalesPerson.LastName}" : "-"
    }));
}

<div class="fixed inset-0 -z-10 h-full w-full bg-slate-50 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:24px_24px]">
    <div class="absolute bottom-0 left-0 right-0 top-0 bg-[radial-gradient(circle_800px_at_100%_200px,#e0e7ff,transparent)]"></div>
</div>

<div class="font-sans antialiased w-full min-h-screen relative overflow-x-hidden flex flex-col items-center py-6 px-4 sm:px-6 lg:px-8 gap-4 pb-32">

    <div class="w-full lg:w-[98%] max-w-[150rem] z-10 flex flex-col gap-4">

        <!-- COMPACT HEADER (Single Row for Controls + Active Filters Below) -->
        <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-3 relative z-[60] flex flex-col gap-3">

            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">

                <!-- Left: Title & Pill Toggle -->
                <div class="flex items-center gap-3 shrink-0 flex-wrap sm:flex-nowrap">
                    <div class="w-8 h-8 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-600 border border-indigo-100 shadow-sm shrink-0">
                        <i class="bi bi-geo-alt-fill fs-6"></i>
                    </div>
                    <h1 class="text-lg font-extrabold text-gray-900 tracking-tight leading-tight m-0 whitespace-nowrap">Beat Routes</h1>

                    <div class="bg-gray-100 p-1 rounded-lg flex ml-1">
                        <button id="btnRouteView" onclick="switchView('RouteView')" class="px-3 py-1 text-[11px] uppercase tracking-wider font-bold rounded bg-white text-indigo-600 shadow-sm transition-all whitespace-nowrap">Route View</button>
                        <button id="btnAccountView" onclick="switchView('AccountView')" class="px-3 py-1 text-[11px] uppercase tracking-wider font-bold rounded text-gray-500 hover:text-gray-700 transition-all whitespace-nowrap">Account View</button>
                    </div>
                </div>

                <!-- Middle: Dynamic Filters -->
                <div class="flex flex-wrap items-center gap-2 flex-1 lg:justify-center" id="topFilterContainer">
                    <!-- Dropdowns injected via JS -->
                </div>

                <!-- Right: Search & Create -->
                <div class="flex items-center gap-2 shrink-0 w-full lg:w-auto">
                    <div class="relative w-full lg:w-48 xl:w-56">
                        <i class="bi bi-search absolute left-3 top-2.5 text-gray-400 text-[10px]"></i>
                        <input type="text" id="searchInput" placeholder="Search..." class="w-full pl-8 pr-3 py-1.5 bg-gray-50 border border-gray-200 rounded-lg text-xs font-medium focus:border-indigo-600 focus:bg-white outline-none transition-all shadow-inner m-0" onkeyup="applyClientFilters()" />
                    </div>
                    <button onclick="openCreateModal()" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-[10px] font-black tracking-widest uppercase transition-colors shadow-sm flex items-center gap-2 whitespace-nowrap m-0 border-0">
                        <i class="bi bi-plus-lg"></i> <span class="hidden sm:inline">Create Beat Route</span>
                    </button>
                </div>
            </div>

            <!-- Bottom Row: Active Filters & Counts -->
            <div class="flex items-center justify-between border-t border-gray-100 pt-2">
                <div class="flex items-center gap-2 overflow-x-auto hide-scrollbar flex-nowrap w-full whitespace-nowrap" id="activeFiltersContainer">
                    <span class="text-[9px] font-extrabold text-gray-400 uppercase tracking-widest shrink-0 mr-1">Active:</span>
                    <span class="text-[11px] font-bold text-gray-400 italic shrink-0" id="noFiltersText">None</span>
                    <!-- Injected Badges -->
                </div>
                <div class="text-right pl-4 shrink-0 border-l border-gray-100 ml-2">
                    <p class="text-[9px] font-bold text-gray-400 uppercase tracking-widest m-0">Showing</p>
                    <p class="text-xs font-black text-indigo-600 m-0"><span id="totalCountDisplay">0</span> Records</p>
                </div>
            </div>
        </div>

        <!-- MAIN DATA AREA -->
        <div class="bg-white/90 backdrop-blur-md rounded-2xl shadow-xl border border-gray-200 relative z-10 w-full overflow-hidden" style="min-height: 600px;">

            <!-- Desktop Table Wrapper -->
            <div class="hidden md:block w-full overflow-x-auto pb-6 custom-scroll h-[70vh]">
                <table class="w-full text-left border-collapse whitespace-nowrap min-w-max">
                    <thead class="sticky top-0 z-20 bg-white shadow-sm border-b border-gray-200" id="tableHeaderRow">
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm" id="tableBody"></tbody>
                </table>
            </div>

            <!-- Mobile SaaS Cards Wrapper -->
            <div class="md:hidden flex flex-col gap-3 w-full p-3 h-[70vh] overflow-y-auto custom-scroll" id="mobileCardsContainer">
            </div>

        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL: CREATE / EDIT ROUTE (Enhanced UI) -->
<!-- ========================================== -->
<div class="modal fade" id="createRouteModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-2xl border-0 shadow-2xl">
            <div class="modal-header bg-gray-50 border-b border-gray-200 py-3 sm:py-4 px-4 sm:px-6">
                <h5 class="modal-title font-extrabold text-gray-800 text-lg sm:text-xl" id="modalTitle">
                    <i class="bi bi-geo-alt-fill text-indigo-600 me-2"></i>Create Beat Route
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="frmSaveRoute">
                <input type="hidden" id="RouteId" value="0" />
                <div class="modal-body p-4 sm:p-6 bg-white">
                    <div class="row g-4 mb-4 sm:mb-5">
                        <div class="col-md-6">
                            <label class="form-label text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Route Name</label>
                            <input type="text" id="RouteName" class="form-control form-control-lg rounded-xl shadow-sm text-sm font-bold" placeholder="e.g. North Delhi Zone A" required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Assign To Sales Person</label>
                            <div class="dropdown w-100">
                                <button class="form-select form-select-lg text-start rounded-xl shadow-sm bg-white text-sm font-bold text-gray-700" type="button" id="spDropdownBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                    -- Select Sales Person --
                                </button>
                                <input type="hidden" id="SalesPersonId" required>
                                <ul class="dropdown-menu w-100 p-2 shadow-xl border border-gray-100 mt-1 rounded-xl" style="max-height: 300px; overflow-y: auto;">
                                    <li class="px-2 pb-2 sticky-top bg-white z-10">
                                        <input type="text" class="form-control form-control-sm rounded-lg border-gray-300" id="spSearchInput" placeholder="Search person..." onkeyup="filterSalesPersons()">
                                    </li>
                                    @foreach (var sp in ViewBag.AllUsers)
                                    {
                                        <li>
                                            <a class="dropdown-item sp-item rounded-lg text-sm font-semibold cursor-pointer py-2 hover:bg-indigo-50 hover:text-indigo-700 transition-colors" data-val="@sp.RecordId" onclick="selectSalesPerson('@sp.RecordId', '@sp.FirstName @sp.LastName')">
                                                <i class="bi bi-person me-2 text-gray-400"></i>@sp.FirstName @sp.LastName
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-4 sm:p-5">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
                            <div>
                                <label class="form-label text-sm sm:text-base font-black text-indigo-700 uppercase tracking-widest m-0"><i class="bi bi-shop me-2"></i>Map Customers</label>
                                <p class="text-xs text-gray-500 font-medium m-0 mt-1">Select the accounts that belong to this route.</p>
                            </div>
                            <div class="relative w-full sm:w-72 shrink-0">
                                <i class="bi bi-search absolute left-3 top-2.5 text-gray-400"></i>
                                <input type="text" id="customerSearch" class="form-control pl-9 py-2 rounded-xl shadow-sm border-gray-300 text-sm font-medium" placeholder="Search accounts..." onkeyup="filterCustomersModal()">
                            </div>
                        </div>

                        <div class="row g-3 custom-scroll" id="customerList" style="max-height: 450px; overflow-y: auto; overflow-x: hidden;">
                            @foreach (var customer in ViewBag.Customers)
                            {
                                <div class="col-sm-6 col-md-4 col-lg-3 customer-item" data-search="@customer.AccountName.ToLower() @customer.City?.ToLower()">
                                    <div class="form-check custom-control bg-white border border-gray-200 rounded-xl p-3 shadow-sm h-100 transition-all hover:border-indigo-400 hover:shadow-md d-flex align-items-start">
                                        <input class="form-check-input customer-check mt-1 cursor-pointer flex-shrink-0" type="checkbox" value="@customer.AccountId" id="cust_@customer.AccountId">
                                        <label class="form-check-label ms-2 cursor-pointer w-100" for="cust_@customer.AccountId">
                                            <span class="font-extrabold text-gray-800 d-block text-wrap text-sm mb-1.5 cust-name leading-tight">@customer.AccountName</span>
                                            <span class="badge bg-gray-100 text-gray-500 border border-gray-200 text-[9px] uppercase tracking-widest">@customer.City</span>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                        <div id="noCustomersFound" class="hidden text-center py-5 text-gray-400 font-bold bg-white rounded-xl border border-gray-100 mt-3">No customers match your search.</div>
                    </div>
                </div>
                <div class="modal-footer bg-gray-50 border-t border-gray-200 py-3 px-4 sm:px-6 d-flex justify-content-between">
                    <button type="button" class="btn btn-light border font-bold px-4 rounded-lg shadow-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary font-bold px-5 rounded-lg shadow-sm" id="btnSaveRoute"><i class="bi bi-save me-2"></i>Save Route</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL: VIEW CUSTOMERS LIST -->
<!-- ========================================== -->
<div class="modal fade" id="viewCustomersModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-2xl border-0 shadow-2xl">
            <div class="modal-header bg-indigo-50 border-b border-indigo-100 py-3 sm:py-4 px-4 sm:px-5">
                <h5 class="modal-title font-extrabold text-indigo-800 text-lg" id="vcRouteName">Customers</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <ul class="list-group list-group-flush custom-scroll" id="vcCustomerList" style="max-height: 50vh; overflow-y: auto;">
                    <!-- Injected via JS -->
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Data injected from C#
        const rawRouteData = @Html.Raw(routeJson);
        const rawAccountData = @Html.Raw(accountJson);

        // Core State
        let currentTab = 'RouteView';
        let masterData = [];
        let filteredData = [];
        let filterColumns = [];
        let activeDropdown = null;
        let currentSort = { col: '', dir: 'asc' };

        // Column Definitions
        const routeColumnsDef = [
            { key: 'id', label: 'Route ID', isArray: false },
            { key: 'routeName', label: 'Route Name', isArray: false },
            { key: 'salesPerson', label: 'Sales Person', isArray: false },
            { key: 'customersList', label: 'Customers', isArray: true } // Filter by names instead of count!
        ];

        const accountColumnsDef = [
            { key: 'customerId', label: 'Customer ID', isArray: false },
            { key: 'customerName', label: 'Customer Name', isArray: false },
            { key: 'routeId', label: 'Route ID', isArray: false },
            { key: 'routeName', label: 'Route Name', isArray: false },
            { key: 'salesPerson', label: 'Sales Person', isArray: false }
        ];

        document.addEventListener("DOMContentLoaded", function () {
            switchView('RouteView');

            // Dropdown outside click handler
            document.addEventListener("click", function (event) {
                if (activeDropdown) {
                    const dropdownMenu = document.getElementById(`dropdownMenu-${activeDropdown}`);
                    const dropdownBtn = document.getElementById(`dropdownBtn-${activeDropdown}`);
                    if (dropdownMenu && !dropdownMenu.contains(event.target) && !dropdownBtn.contains(event.target)) {
                        dropdownMenu.classList.add('hidden');
                        activeDropdown = null;
                    }
                }
            });
        });

        // --- MAIN UI SWITCHER ---
        function switchView(viewName) {
            currentTab = viewName;
            masterData = viewName === 'RouteView' ? rawRouteData : rawAccountData;
            filterColumns = viewName === 'RouteView' ? routeColumnsDef : accountColumnsDef;
            currentSort = { col: '', dir: 'asc' };

            const btnRoute = document.getElementById('btnRouteView');
            const btnAcc = document.getElementById('btnAccountView');

            if (viewName === 'RouteView') {
                btnRoute.className = "px-4 py-1.5 text-[11px] uppercase tracking-wider font-bold rounded bg-white text-indigo-600 shadow-sm transition-all whitespace-nowrap";
                btnAcc.className = "px-4 py-1.5 text-[11px] uppercase tracking-wider font-bold rounded text-gray-500 hover:text-gray-700 transition-all whitespace-nowrap";
            } else {
                btnAcc.className = "px-4 py-1.5 text-[11px] uppercase tracking-wider font-bold rounded bg-white text-indigo-600 shadow-sm transition-all whitespace-nowrap";
                btnRoute.className = "px-4 py-1.5 text-[11px] uppercase tracking-wider font-bold rounded text-gray-500 hover:text-gray-700 transition-all whitespace-nowrap";
            }

            document.getElementById('searchInput').value = '';
            buildTableHeaders();
            buildTopFilterBar();
            applyClientFilters();
        }

        function buildTableHeaders() {
            const headerRow = document.getElementById('tableHeaderRow');
            let html = '';

            filterColumns.forEach(col => {
                html += `
                            <th class="px-6 py-4 cursor-pointer transition-colors hover:bg-gray-100 border-r border-gray-100 last:border-0" onclick="sortTable('${col.key}')">
                                <span class="text-[10px] font-extrabold uppercase tracking-widest text-gray-500 hover:text-indigo-600">${col.label}</span>
                                <span id="sort-icon-${col.key}" class="text-gray-400 font-bold ml-1"></span>
                            </th>
                        `;
            });

            if (currentTab === 'RouteView') {
                html += `<th class="px-6 py-4 text-end"><span class="text-[10px] font-extrabold uppercase tracking-widest text-gray-500">Actions</span></th>`;
            }

            headerRow.innerHTML = html;
        }

        // --- DYNAMIC FILTER CREATION ---
        function buildTopFilterBar() {
            const container = document.getElementById('topFilterContainer');
            const labelHtml = `<span class="text-[10px] font-extrabold text-gray-400 uppercase tracking-widest mr-1 shrink-0 mt-1">Filters:</span>`;

            let dropdownsHtml = '';
            filterColumns.forEach(col => {

                let uniqueVals = [];
                if (col.isArray) {
                    let allVals = [];
                    masterData.forEach(item => {
                        if (item[col.key] && Array.isArray(item[col.key])) allVals.push(...item[col.key]);
                    });
                    uniqueVals = [...new Set(allVals)].filter(v => v !== '-' && v !== '').sort();
                } else {
                    uniqueVals = [...new Set(masterData.map(item => String(item[col.key] || '-')))].filter(v => v !== '-').sort();
                }

                let optionsHtml = uniqueVals.map(val => `
                            <label class="flex items-center gap-2 p-1.5 hover:bg-gray-50 rounded cursor-pointer filter-item">
                                <input type="checkbox" value="${val.replace(/"/g, '&quot;')}" class="cb-${col.key} text-indigo-600 rounded border-gray-300 focus:ring-indigo-500" checked onchange="handleCheckboxChange('${col.key}', this)" />
                                <span class="text-xs font-medium text-gray-700 truncate" title="${val.replace(/"/g, '&quot;')}">${val}</span>
                            </label>
                        `).join('');

                let innerContent = `
                            <input type="text" id="filterSearch-${col.key}" placeholder="Search ${col.label}..." class="w-full px-2 py-1.5 text-xs border border-gray-200 rounded-md outline-none focus:border-indigo-600 mb-2" onkeyup="searchDropdownOptions('${col.key}', this.value)" />
                            <label class="flex items-center gap-2 text-xs font-bold text-gray-700 border-b border-gray-100 pb-2 mb-1 cursor-pointer hover:text-indigo-600">
                                <input type="checkbox" id="selectAll-${col.key}" onchange="toggleSelectAll('${col.key}', this.checked)" checked class="text-indigo-600 rounded border-gray-300 focus:ring-indigo-600" /> Select All
                            </label>
                            <div id="optionsList-${col.key}" class="max-h-48 overflow-y-auto flex flex-col gap-0.5 pr-1 custom-scroll">
                                ${optionsHtml}
                            </div>
                        `;

                dropdownsHtml += `
                            <div class="relative inline-block text-left shrink-0 m-0">
                                <button type="button" id="dropdownBtn-${col.key}" class="px-2.5 py-1 bg-white border border-gray-300 rounded text-[10px] font-bold text-gray-600 hover:border-indigo-500 hover:text-indigo-600 whitespace-nowrap transition-colors flex items-center gap-1 shadow-sm border-0 m-0" onclick="toggleDropdown('${col.key}')">
                                    <span id="btnText-${col.key}">${col.label}</span>
                                    <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                </button>
                                <div id="dropdownMenu-${col.key}" class="hidden absolute top-full left-0 mt-1 w-64 bg-white border border-gray-200 shadow-2xl rounded-xl z-[100] p-3 flex flex-col gap-2">
                                    ${innerContent}
                                    <div class="flex justify-between border-t border-gray-100 pt-2 mt-1">
                                        <button type="button" onclick="clearSpecificFilter('${col.key}')" class="text-xs text-gray-500 font-bold hover:text-gray-800 bg-transparent border-0">Clear</button>
                                        <button type="button" onclick="applyClientFilters(); closeDropdown('${col.key}')" class="px-3 py-1.5 bg-indigo-600 text-white rounded-lg text-xs font-bold shadow-sm hover:bg-indigo-700 border-0">Apply</button>
                                    </div>
                                </div>
                            </div>
                        `;
            });
            container.innerHTML = labelHtml + dropdownsHtml;
        }

        // --- FILTER HELPERS ---
        function toggleDropdown(colKey) {
            const menu = document.getElementById(`dropdownMenu-${colKey}`);
            if (menu.classList.contains('hidden')) {
                if (activeDropdown && activeDropdown !== colKey) closeDropdown(activeDropdown);
                menu.classList.remove('hidden');
                activeDropdown = colKey;
            } else {
                closeDropdown(colKey);
            }
        }
        function closeDropdown(colKey) { document.getElementById(`dropdownMenu-${colKey}`).classList.add('hidden'); activeDropdown = null; }
        function toggleSelectAll(colKey, isChecked) { document.querySelectorAll(`.cb-${colKey}`).forEach(cb => { if (cb.closest('label').style.display !== 'none') cb.checked = isChecked; }); }
        function clearSpecificFilter(colKey) {
            document.getElementById(`selectAll-${colKey}`).checked = true;
            toggleSelectAll(colKey, true);
            applyClientFilters();
            closeDropdown(colKey);
        }
        function searchDropdownOptions(colKey, term) {
            term = term.toLowerCase().trim();
            document.querySelectorAll(`#optionsList-${colKey} .filter-item`).forEach(label => {
                const text = label.querySelector('span').textContent.toLowerCase();
                label.style.display = text.includes(term) ? 'flex' : 'none';
            });
        }
        function handleCheckboxChange(colKey, cb) {
            const selectAll = document.getElementById(`selectAll-${colKey}`);
            if (selectAll && selectAll.checked) {
                document.querySelectorAll(`.cb-${colKey}`).forEach(box => box.checked = false);
                cb.checked = true;
                selectAll.checked = false;
            } else if (selectAll) {
                const total = document.querySelectorAll(`.cb-${colKey}`).length;
                const checked = document.querySelectorAll(`.cb-${colKey}:checked`).length;
                selectAll.checked = (total === checked && total > 0);
            }
        }

        // --- CORE FILTERING & RENDERING ENGINE ---
        function applyClientFilters() {
            let activeFilters = {};
            const activeFiltersContainer = document.getElementById('activeFiltersContainer');
            const noFiltersText = document.getElementById('noFiltersText');

            Array.from(activeFiltersContainer.querySelectorAll('.filter-badge')).forEach(el => el.remove());
            let hasFilters = false;

            const addBadge = (label, text) => {
                hasFilters = true;
                const badge = document.createElement('span');
                badge.className = "filter-badge bg-indigo-50 border border-indigo-200 text-indigo-700 px-2 py-0.5 rounded text-[10px] font-bold shadow-sm shrink-0 flex items-center";
                badge.innerHTML = `<span class="text-gray-500 mr-1">${label}:</span> <span class="truncate max-w-[200px]">${text}</span>`;
                activeFiltersContainer.appendChild(badge);
            };

            filterColumns.forEach(col => {
                const btnText = document.getElementById(`btnText-${col.key}`);
                const btnObj = document.getElementById(`dropdownBtn-${col.key}`);
                const selectAll = document.getElementById(`selectAll-${col.key}`);

                if (selectAll && !selectAll.checked) {
                    const checkedValues = Array.from(document.querySelectorAll(`.cb-${col.key}:checked`)).map(cb => cb.value);
                    activeFilters[col.key] = checkedValues;

                    btnObj.classList.add('bg-indigo-50', 'text-indigo-800');
                    let displayText = checkedValues.length <= 2 ? checkedValues.join(', ') : `${checkedValues.length} Selected`;
                    btnText.textContent = `${col.label}: ${displayText}`;
                    addBadge(col.label, displayText);
                } else if (btnText) {
                    btnObj.classList.remove('bg-indigo-50', 'text-indigo-800');
                    btnText.textContent = col.label;
                }
            });

            if (hasFilters) noFiltersText.classList.add('hidden');
            else noFiltersText.classList.remove('hidden');

            const globalSearch = document.getElementById('searchInput').value.toLowerCase().trim();

            filteredData = masterData.filter(item => {
                // Global text search
                if (globalSearch) {
                    let searchStr = "";
                    filterColumns.forEach(c => {
                        if (item[c.key]) {
                            searchStr += (c.isArray ? item[c.key].join(" ") : String(item[c.key])) + " ";
                        }
                    });
                    if (!searchStr.toLowerCase().includes(globalSearch)) return false;
                }

                // Dropdown matches
                for (const key in activeFilters) {
                    const colDef = filterColumns.find(c => c.key === key);
                    if (colDef.isArray) {
                        const itemArr = item[key] || [];
                        const hasMatch = itemArr.some(val => activeFilters[key].includes(String(val)));
                        if (!hasMatch) return false;
                    } else {
                        const itemVal = item[key] || '-';
                        if (!activeFilters[key].includes(String(itemVal))) return false;
                    }
                }
                return true;
            });

            document.getElementById('totalCountDisplay').innerText = filteredData.length;
            renderData();
        }

        // --- RENDERING DESKTOP & MOBILE VIEWS ---
        function renderData() {
            const tbody = document.getElementById('tableBody');
            const mobileContainer = document.getElementById('mobileCardsContainer');
            tbody.innerHTML = '';
            mobileContainer.innerHTML = '';

            if (filteredData.length === 0) {
                tbody.innerHTML = `<tr><td colspan="10" class="px-6 py-16 text-center text-gray-500 font-bold"><p class="text-lg">No records found.</p></td></tr>`;
                mobileContainer.innerHTML = `<div class="text-center py-10 text-gray-400 font-bold bg-white rounded-xl shadow-sm border border-gray-200">No records found.</div>`;
                return;
            }

            filteredData.forEach(t => {
                // Desktop Row
                let tr = document.createElement('tr');
                tr.className = "hover:bg-indigo-50/20 transition-colors bg-white border-b border-gray-100";

                let html = '';
                if (currentTab === 'RouteView') {
                    // Show names truncated, not numbers!
                    let custNamesText = t.customersList && t.customersList.length > 0 ? t.customersList.join(", ") : "No Customers";

                    html += `
                                <td class="px-6 py-4 font-bold text-indigo-600 border-r border-gray-100">${t.id}</td>
                                <td class="px-6 py-4 font-bold text-gray-800 whitespace-normal break-words min-w-[200px] border-r border-gray-100">${t.routeName}</td>
                                <td class="px-6 py-4 font-semibold text-gray-600 border-r border-gray-100">${t.salesPerson}</td>
                                <td class="px-6 py-4 border-r border-gray-100">
                                    <button type="button" onclick="showCustomersModal('${t.routeName.replace(/'/g, "\\'")}', ${JSON.stringify(t.customersList).replace(/"/g, '&quot;')})" class="text-indigo-600 hover:text-indigo-800 text-xs font-bold truncate max-w-[250px] inline-block cursor-pointer text-left bg-transparent border-0 p-0 m-0" title="${custNamesText.replace(/"/g, '&quot;')}">
                                        ${custNamesText}
                                    </button>
                                </td>
                                <td class="px-6 py-4 text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <button class="btn btn-sm btn-light border text-primary shadow-sm" onclick="showCustomersModal('${t.routeName.replace(/'/g, "\\'")}', ${JSON.stringify(t.customersList).replace(/"/g, '&quot;')})"><i class="bi bi-eye"></i></button>
                                        <button class="btn btn-sm btn-light border text-warning shadow-sm" onclick="openEditModal(${t.rawId}, '${t.routeName.replace(/'/g, "\\'")}', '${t.salesPersonId}', ${JSON.stringify(t.customerIds)})"><i class="bi bi-pencil-square"></i></button>
                                    </div>
                                </td>
                            `;
                } else {
                    html += `
                                <td class="px-6 py-4 font-mono font-bold text-gray-500 text-xs border-r border-gray-100">${t.customerId}</td>
                                <td class="px-6 py-4 font-bold text-gray-800 whitespace-normal break-words border-r border-gray-100">${t.customerName}</td>
                                <td class="px-6 py-4 font-bold text-indigo-600 border-r border-gray-100">${t.routeId}</td>
                                <td class="px-6 py-4 font-semibold text-gray-700 border-r border-gray-100">${t.routeName}</td>
                                <td class="px-6 py-4 font-semibold text-gray-600 border-r border-gray-100">${t.salesPerson}</td>
                            `;
                }
                tr.innerHTML = html;
                tbody.appendChild(tr);

                // Mobile Card
                let card = document.createElement('div');
                card.className = "bg-white rounded-xl shadow-sm border border-gray-200 p-4 flex flex-col gap-2";

                let cardHtml = '';
                if (currentTab === 'RouteView') {
                    let custNamesText = t.customersList && t.customersList.length > 0 ? t.customersList.join(", ") : "No Customers";
                    cardHtml = `
                                <div class="flex justify-between items-start">
                                    <span class="px-2 py-1 bg-indigo-50 text-indigo-700 text-[10px] font-black rounded border border-indigo-100 uppercase tracking-widest">${t.id}</span>
                                </div>
                                <div>
                                    <h3 class="text-base font-extrabold text-gray-900 m-0 leading-tight">${t.routeName}</h3>
                                    <p class="text-xs font-bold text-gray-500 m-0 mt-1"><i class="bi bi-person-badge me-1"></i>${t.salesPerson}</p>
                                    <p class="text-[10px] font-bold text-indigo-500 m-0 mt-2 truncate w-full" onclick="showCustomersModal('${t.routeName.replace(/'/g, "\\'")}', ${JSON.stringify(t.customersList).replace(/"/g, '&quot;')})"><i class="bi bi-shop me-1"></i> ${custNamesText}</p>
                                </div>
                                <div class="flex justify-end gap-2 border-t border-gray-100 pt-3 mt-1">
                                    <button class="flex-1 py-2 bg-white border border-gray-200 text-primary rounded-lg text-xs font-bold shadow-sm" onclick="showCustomersModal('${t.routeName.replace(/'/g, "\\'")}', ${JSON.stringify(t.customersList).replace(/"/g, '&quot;')})"><i class="bi bi-eye me-1"></i> View Customers</button>
                                    <button class="flex-1 py-2 bg-white border border-gray-200 text-warning rounded-lg text-xs font-bold shadow-sm" onclick="openEditModal(${t.rawId}, '${t.routeName.replace(/'/g, "\\'")}', '${t.salesPersonId}', ${JSON.stringify(t.customerIds)})"><i class="bi bi-pencil-square me-1"></i> Edit Route</button>
                                </div>
                            `;
                } else {
                    cardHtml = `
                                <div class="flex justify-between items-start mb-1">
                                    <span class="px-2 py-1 bg-gray-100 text-gray-600 text-[10px] font-black rounded border border-gray-200 uppercase">${t.customerId}</span>
                                    <span class="px-2 py-1 bg-indigo-50 text-indigo-700 text-[10px] font-black rounded border border-indigo-100 uppercase">${t.routeId}</span>
                                </div>
                                <h3 class="text-sm font-extrabold text-gray-900 m-0 leading-tight">${t.customerName}</h3>
                                <div class="mt-2 p-2 bg-gray-50 rounded-lg border border-gray-100">
                                    <p class="text-[10px] font-bold text-gray-500 m-0 uppercase tracking-wider mb-1">Route: <span class="text-gray-800">${t.routeName}</span></p>
                                    <p class="text-[10px] font-bold text-gray-500 m-0 uppercase tracking-wider">Rep: <span class="text-gray-800">${t.salesPerson}</span></p>
                                </div>
                            `;
                }
                card.innerHTML = cardHtml;
                mobileContainer.appendChild(card);
            });
        }

        // --- SORTING ---
        function sortTable(colKey) {
            if (currentSort.col === colKey) { currentSort.dir = currentSort.dir === 'asc' ? 'desc' : 'asc'; }
            else { currentSort.col = colKey; currentSort.dir = 'asc'; }

            document.querySelectorAll('th span[id^="sort-icon-"]').forEach(icon => icon.innerHTML = '');
            const activeIcon = document.getElementById(`sort-icon-${colKey}`);
            if (activeIcon) activeIcon.innerHTML = currentSort.dir === 'asc' ? '↑' : '↓';

            filteredData.sort((a, b) => {
                let valA = a[colKey] || '';
                let valB = b[colKey] || '';

                // If sorting arrays (like customersList), sort by the length or joined string
                if (Array.isArray(valA)) valA = valA.join(", ");
                if (Array.isArray(valB)) valB = valB.join(", ");

                const numA = parseFloat(valA);
                const numB = parseFloat(valB);

                if (!isNaN(numA) && !isNaN(numB)) { return currentSort.dir === 'asc' ? numA - numB : numB - numA; }
                return currentSort.dir === 'asc' ? String(valA).localeCompare(String(valB)) : String(valB).localeCompare(String(valA));
            });

            renderData(); // Re-render sorted data
        }

        // --- MODAL & CUSTOMER LOGIC ---
        function showCustomersModal(routeName, customersArr) {
            $('#vcRouteName').text(routeName + " Customers");
            let list = $('#vcCustomerList');
            list.empty();

            if (!customersArr || customersArr.length === 0) {
                list.append('<li class="list-group-item text-muted text-center py-5 font-bold border-0">No customers mapped.</li>');
            } else {
                customersArr.forEach(name => {
                    list.append(`
                                <li class="list-group-item font-bold text-gray-800 py-3 px-4 sm:px-5 hover:bg-indigo-50/30 transition-colors d-flex align-items-start border-b border-gray-100">
                                    <i class="bi bi-shop text-indigo-400 me-3 mt-0.5"></i>
                                    <span class="text-wrap leading-tight">${name}</span>
                                </li>`);
                });
            }
            new bootstrap.Modal(document.getElementById('viewCustomersModal')).show();
        }

        function openCreateModal() {
            $('#modalTitle').html('<i class="bi bi-geo-alt-fill text-indigo-600 me-2"></i>Create Beat Route');
            $('#RouteId').val(0);
            $('#RouteName').val('');
            $('#customerSearch').val('');
            filterCustomersModal();
            selectSalesPerson('', '-- Select Sales Person --');
            $('.customer-check').prop('checked', false).closest('.custom-control').removeClass('border-indigo-500 bg-indigo-50/30'); $('#createRouteModal').modal('show');
        }

        function openEditModal(id, name, spId, customerIds) {
            $('#modalTitle').html('<i class="bi bi-pencil-square text-warning me-2"></i>Edit Beat Route');
            $('#RouteId').val(id);
            $('#RouteName').val(name);
            $('#customerSearch').val('');
            filterCustomersModal();

            let spName = '-- Select Sales Person --';
            let spElement = $(`.sp-item[data-val="${spId}"]`);
            if (spElement.length > 0) spName = spElement.text().trim();
            selectSalesPerson(spId, spName);

            $('.customer-check').prop('checked', false).closest('.custom-control').removeClass('border-indigo-500 bg-indigo-50/30');

            customerIds.forEach(cid => {
                let cb = $('#cust_' + cid);
                cb.prop('checked', true).closest('.custom-control').addClass('border-indigo-500 bg-indigo-50/30');
            });

            $('#createRouteModal').modal('show');
        }

        $(document).on('change', '.customer-check', function () {
            if ($(this).is(':checked')) $(this).closest('.custom-control').addClass('border-indigo-500 bg-indigo-50/30');
            else $(this).closest('.custom-control').removeClass('border-indigo-500 bg-indigo-50/30');
        });

        // Dropdown Search logic
        function selectSalesPerson(id, name) {
            $('#SalesPersonId').val(id);
            $('#spDropdownBtn').html(`<i class="bi bi-person me-2 text-indigo-600"></i>${name}`);
            var dropdown = bootstrap.Dropdown.getInstance(document.getElementById('spDropdownBtn'));
            if (dropdown) dropdown.hide();
        }

        function filterSalesPersons() {
            let term = $('#spSearchInput').val().toLowerCase();
            $('.sp-item').each(function () {
                let name = $(this).text().toLowerCase(); $(this).closest('li').toggle(name.includes(term));
            });
        }

        function filterCustomersModal() {
            let term = $('#customerSearch').val().toLowerCase().trim();
            let terms = term.split(' ').filter(t => t.length > 0);
            let visibleCount = 0;

            $('.customer-item').each(function () {
                let searchData = $(this).data('search');
                let isMatch = terms.every(t => searchData.includes(t));
                $(this).toggle(isMatch || term.length === 0);
                if (isMatch || term.length === 0) visibleCount++;
            });

            if (visibleCount === 0) $('#noCustomersFound').removeClass('hidden');
            else $('#noCustomersFound').addClass('hidden');
        }

        // Form Submit
        $('#frmSaveRoute').on('submit', function (e) {
            e.preventDefault();

            if (!$('#SalesPersonId').val()) return alert("Please select a Sales Person.");

            let btn = $('#btnSaveRoute');
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Saving...');

            let selectedCustomers = [];
            $('.customer-check:checked').each(function () { selectedCustomers.push($(this).val()); });

            if (selectedCustomers.length === 0) {
                alert("Please map at least one customer to this route.");
                btn.prop('disabled', false).html('<i class="bi bi-save me-2"></i>Save Route');
                return;
            }

            $.post('/BeatRoute/SaveRoute', {
                routeId: $('#RouteId').val(),
                routeName: $('#RouteName').val(),
                salesPersonId: $('#SalesPersonId').val(),
                customerIds: selectedCustomers
            }, function (res) {
                if (res.success) location.reload();
                else { alert("Error: " + res.message); btn.prop('disabled', false).html('<i class="bi bi-save me-2"></i>Save Route'); }
            }).fail(function () {
                alert("Network error occurred.");
                btn.prop('disabled', false).html('<i class="bi bi-save me-2"></i>Save Route');
            });
        });
    </script>
}
@model List<Publisher_CRM.Models.RoleHierarchyNode>

@{
    ViewData["Title"] = "Organization Roles";
}

<style>
    /* Zoho-Style Minimalist Tree CSS */
    .zoho-tree {
        list-style-type: none;
        padding-left: 20px;
        margin: 0;
    }

        .zoho-tree li {
            margin: 0;
            padding: 10px 0 10px 25px;
            position: relative;
        }

            /* The vertical dashed line */
            .zoho-tree li::before {
                content: '';
                position: absolute;
                top: 0;
                bottom: 0;
                left: 0;
                border-left: 1px dashed #8fa1b3;
            }

            /* The horizontal dashed line */
            .zoho-tree li::after {
                content: '';
                position: absolute;
                top: 22px; /* aligns with middle of text */
                left: 0;
                width: 20px;
                border-top: 1px dashed #8fa1b3;
            }

            /* Stop the vertical line on the last child so it doesn't extend infinitely */
            .zoho-tree li:last-child::before {
                bottom: auto;
                height: 22px;
            }

    /* Root element shouldn't have lines above it */
    .root-tree > li::before, .root-tree > li::after {
        display: none;
    }

    .root-tree > li {
        padding-left: 0;
    }

    /* Node Styling */
    .role-wrapper {
        display: inline-flex;
        align-items: center;
    }

    .role-box {
        display: inline-flex;
        align-items: center;
        background-color: transparent;
        padding: 2px 8px;
        border-radius: 4px;
        transition: background-color 0.2s;
    }

        .role-box:hover {
            background-color: #f4f6f8;
        }

    .tree-icon {
        color: #7a8b9a;
        font-size: 14px;
        margin-right: 8px;
        border: 1px solid #d2d6da;
        border-radius: 2px;
        padding: 1px 3px;
        background: #fff;
    }

    .role-text {
        font-size: 15px;
        color: #212529;
        cursor: pointer;
    }

        .role-text:hover {
            color: #0056b3;
            text-decoration: underline;
        }

    /* Action Icons (Hidden by default, shown on wrapper hover) */
    .role-actions {
        opacity: 0;
        margin-left: 15px;
        transition: opacity 0.2s ease-in-out;
        display: flex;
        gap: 10px;
    }

    .role-wrapper:hover .role-actions {
        opacity: 1;
    }

    .action-icon {
        cursor: pointer;
        font-size: 14px;
        color: #6c757d;
        padding: 4px;
        border-radius: 4px;
    }

        .action-icon:hover {
            background-color: #e9ecef;
        }

    .icon-edit:hover {
        color: #0d6efd;
    }

    .icon-delete:hover {
        color: #dc3545;
    }

    .icon-add:hover {
        color: #198754;
    }
</style>

<div class="container mt-4 p-4 bg-white rounded shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h4 class="mb-1 text-dark">Organization Roles</h4>
            <small class="text-muted">Click on a role to view its assigned users.</small>
        </div>
        <button type="button" class="btn btn-sm btn-primary px-3" data-bs-toggle="modal" data-bs-target="#roleModal" onclick="openCreateModal()">
            + New Role
        </button>
    </div>

    <!-- Recursive function to render the tree -->
    @{
        void RenderTree(IEnumerable<Publisher_CRM.Models.RoleHierarchyNode> nodes, int? currentParentId)
        {
            if (nodes != null && nodes.Any())
            {
                <ul class="zoho-tree">
                    @foreach (var node in nodes)
                    {
                        <li>
                            <div class="role-wrapper">
                                <div class="role-box">
                                    <span class="tree-icon"><i class="bi bi-dash"></i></span>
                                    <span class="role-text" onclick="viewUsers('@Html.Raw(node.Name.Replace("'", "\\'"))')">@node.Name</span>
                                </div>

                                <!-- Small Action Icons -->
                                <div class="role-actions">
                                    <i class="bi bi-plus-lg action-icon icon-add" title="Add Subordinate" onclick="openCreateModal(@node.Id)"></i>
                                    <i class="bi bi-pencil action-icon icon-edit" title="Edit" onclick="openEditModal(@node.Id, '@Html.Raw(node.Name.Replace("'", "\\'"))', @(currentParentId.HasValue ? currentParentId.Value.ToString() : "null"))"></i>
                                    <i class="bi bi-trash action-icon icon-delete" title="Delete" onclick="deleteRole(@node.Id)"></i>
                                </div>
                            </div>
                            @{
                                RenderTree(node.Children, node.Id);
                            }
                        </li>
                    }
                </ul>
            }
        }
    }

    <!-- Render the Tree Data -->
    <div class="pt-2">
        @if (Model != null && Model.Any())
        {
            <ul class="zoho-tree root-tree">
                <li>
                    @{
                        RenderTree(Model, null);
                    }
                </li>
            </ul>
        }
        else
        {
            <p class="text-muted ms-3">No roles found. Create one to get started.</p>
        }
    </div>
</div>

<!-- ROLE MODAL (Used for both Create and Edit) -->
<div class="modal fade" id="roleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h6 class="modal-title mb-0" id="roleModalLabel">New Role</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="roleForm">
                    <input type="hidden" id="RoleId" name="Id" value="0" />

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Role Name <span class="text-danger">*</span></label>
                        <input type="text" name="Name" id="RoleName" class="form-control form-control-sm" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Reports To</label>
                        <select name="ParentRoleId" id="ParentRoleId" class="form-select form-select-sm">
                            <option value="">-- None (Top Level) --</option>
                            @if (ViewBag.ParentRoles != null)
                            {
                                foreach (var item in (List<SelectListItem>)ViewBag.ParentRoles)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Description</label>
                        <textarea name="Description" id="RoleDescription" class="form-control form-control-sm" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top-0 bg-light">
                <button type="button" class="btn btn-sm btn-white border" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary px-4" id="btnSaveRole">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- VIEW USERS MODAL -->
<div class="modal fade" id="viewUsersModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content shadow border-0">
            <div class="modal-header bg-light border-bottom-0 pb-2">
                <h6 class="modal-title">Users in <span id="displayRoleName" class="text-primary"></span></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <ul class="list-group list-group-flush" id="usersListContainer">
                    <!-- Users injected here -->
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let isEditMode = false;

        // Open Modal for Creating a New Role
        function openCreateModal(parentRoleId = '') {
             isEditMode = false;
             document.getElementById('roleModalLabel').innerText = "New Role";
             document.getElementById('roleForm').reset();
             document.getElementById('RoleId').value = "0";

             if (parentRoleId) {
                 document.getElementById('ParentRoleId').value = parentRoleId;
             }

             const modalEl = document.getElementById('roleModal');
             bootstrap.Modal.getOrCreateInstance(modalEl).show();
         }

         // Open Modal for Editing an Existing Role
         function openEditModal(id, name, parentId) {
             isEditMode = true;
             document.getElementById('roleModalLabel').innerText = "Edit Role";
             document.getElementById('roleForm').reset();

             document.getElementById('RoleId').value = id;
             document.getElementById('RoleName').value = name;

             // Set the dropdown (if null, it sets to the default top-level option)
             document.getElementById('ParentRoleId').value = parentId || '';

             const modalEl = document.getElementById('roleModal');
             bootstrap.Modal.getOrCreateInstance(modalEl).show();
         }

        // Save Form (Handles both Create and Edit via AJAX)
        document.getElementById('btnSaveRole').addEventListener('click', function () {
            const form = document.getElementById('roleForm');
            const formData = new FormData(form);

            if (!document.getElementById('RoleName').value) {
                alert("Role Name is required.");
                return;
            }

            const targetUrl = isEditMode ? '@Url.Action("EditAjax", "Roles")' : '@Url.Action("CreateAjax", "Roles")';

            fetch(targetUrl, {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.location.reload();
                } else {
                    alert(data.message || "An error occurred while saving.");
                }
            })
            .catch(error => console.error('Error:', error));
        });

        // Delete Role Function
        function deleteRole(roleId) {
            if (confirm("Delete this role? This cannot be undone.")) {
                fetch(`@Url.Action("DeleteAjax", "Roles")?id=${roleId}`, {
                    method: 'POST'
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.reload();
                    } else {
                        alert(data.message || "Cannot delete. Please reassign subordinates first.");
                    }
                })
                .catch(error => console.error('Error:', error));
            }
        }

        // View Users Modal Function
        function viewUsers(roleName) {
            document.getElementById('displayRoleName').textContent = roleName;
            const listContainer = document.getElementById('usersListContainer');
            listContainer.innerHTML = '<li class="list-group-item text-center text-muted small py-4">Loading users...</li>';

            new bootstrap.Modal(document.getElementById('viewUsersModal')).show();

            fetch(`@Url.Action("GetUsersByRole", "Roles")?roleName=${encodeURIComponent(roleName)}`)
                .then(response => response.json())
                .then(users => {
                    listContainer.innerHTML = '';

                    if (users.length === 0) {
                        listContainer.innerHTML = '<li class="list-group-item text-center text-muted small py-4">No users found in this role.</li>';
                        return;
                    }

                    users.forEach(user => {
                        listContainer.innerHTML += `
                            <li class="list-group-item d-flex justify-content-between align-items-center border-start-0 border-end-0">
                                <div>
                                    <div class="fw-bold small text-dark">${user.fullName}</div>
                                    <div class="text-muted" style="font-size: 12px;">${user.email || ''}</div>
                                </div>
                            </li>
                        `;
                    });
                })
                .catch(error => {
                    listContainer.innerHTML = '<li class="list-group-item text-danger small py-4">Error loading users.</li>';
                });
        }
    </script>
}
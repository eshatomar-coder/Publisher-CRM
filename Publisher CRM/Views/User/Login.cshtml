@model Publisher_CRM.Models.Users

@{
    ViewData["Title"] = "Login - Publisher CRM";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 flex items-center justify-center h-screen">

    <div class="bg-white p-8 rounded-lg shadow-md w-96 border border-gray-100">
        <h2 class="text-2xl font-bold text-center text-gray-800 mb-6">Publisher CRM</h2>

        <!-- Displays the custom error messages we set in the controller -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-4 p-3 bg-red-50 text-red-700 text-sm rounded border border-red-200">
                <div asp-validation-summary="All" class="list-disc pl-4"></div>
            </div>
        }

        <form asp-controller="User" asp-action="Login" method="post" class="space-y-4">

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-gray-700">Email Address</label>
                <!-- Binds directly to the Email property in your Users model -->
                <input asp-for="Email" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" placeholder="admin@publisher.com" />
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-medium text-gray-700">Password</label>
                <!-- Binds directly to the Password property -->
                <input asp-for="Password" type="password" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" placeholder="••••••••" />
            </div>

            <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                Sign In
            </button>

        </form>
    </div>

</body>
</html>
@model Publisher_CRM.Models.Users

@{
    ViewData["Title"] = "Edit User";
}

<style>
    body {
        background-color: #f4f7f6;
    }

    .crm-card {
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        border: none;
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .crm-header {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: white;
        padding: 25px;
    }

    .section-title {
        color: #1e3c72;
        font-weight: 700;
        font-size: 1.2rem;
        margin-bottom: 1.5rem;
        padding-bottom: 8px;
        border-bottom: 3px solid #ffb703;
        display: inline-block;
    }

    .form-section {
        background-color: #ffffff;
        padding: 25px;
        border-radius: 8px;
        margin-bottom: 25px;
        border: 1px solid #e9ecef;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
        font-size: 0.9rem;
    }

    .form-control, .form-select {
        border-radius: 6px;
        border: 1px solid #ced4da;
        transition: all 0.3s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: #ffb703;
            box-shadow: 0 0 0 0.25rem rgba(255, 183, 3, 0.25);
        }

    .btn-save {
        background-color: #ffb703;
        color: #1e3c72;
        font-weight: bold;
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        transition: 0.3s;
    }

        .btn-save:hover {
            background-color: #fb8500;
            color: white;
            transform: translateY(-2px);
        }
</style>

<div class="container py-5">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card crm-card">
        <div class="crm-header d-flex justify-content-between align-items-center">
            <h2 class="m-0">✏️ Edit User</h2>
            <a asp-action="Index" class="btn btn-light btn-sm text-dark fw-bold">Cancel / Back</a>
        </div>
        <div class="card-body p-4 p-md-5">
            <form asp-action="Edit" method="post">

                <!-- CRITICAL: Hidden fields required for the update to work correctly -->
                <input type="hidden" asp-for="RecordId" />
                <input type="hidden" asp-for="Zuid" />

                <div class="form-section">
                    <h4 class="section-title">Core Identity</h4>

                    <div class="mb-3 p-3 bg-light rounded text-muted small">
                        <strong>Record ID:</strong> @Model.RecordId
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label asp-for="FirstName" class="form-label">First Name</label>
                            <input asp-for="FirstName" class="form-control" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="LastName" class="form-label">Last Name</label>
                            <input asp-for="LastName" class="form-control" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" type="email" class="form-control" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="RoleId" class="form-label fw-bold">Role</label>
                            <select asp-for="RoleId" class="form-select" asp-items="ViewBag.RolesList">
                                <option value="">-- Select a Role --</option>
                            </select>
                            <span asp-validation-for="RoleId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="Profile" class="form-label">Profile <span class="text-danger">*</span></label>
                            <select asp-for="Profile" class="form-select" required>
                                <option value="">-- Select Profile --</option>
                                <option value="General">General</option>
                                <option value="Administrator">Administrator</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="Type" class="form-label">User Type</label>
                            <select asp-for="Type" class="form-select">
                                <option value="">-- Select Type --</option>
                                <option value="Internal">Internal</option>
                                <option value="External">External</option>
                                <option value="Contractor">Contractor</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="Phone" class="form-label">Phone</label>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Mobile" class="form-label">Mobile</label>
                            <input asp-for="Mobile" class="form-control" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="UserStatus" class="form-label">User Status</label>
                            <select asp-for="UserStatus" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Non Active">In Active</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="SalesCallAssign" class="form-label">SalesCall Assign</label>
                            <select asp-for="SalesCallAssign" class="form-select">
                                <option value="">-- Select Access Level --</option>
                                <option value="Special SalesCall">Special SalesCall</option>
                                <option value="Whole SalesCall">Whole SalesCall</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h4 class="section-title">Address & Region</h4>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Street" class="form-label">Street</label>
                            <input asp-for="Street" class="form-control" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label asp-for="City" class="form-label">City</label>
                            <input asp-for="City" class="form-control" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label asp-for="State" class="form-label">State</label>
                            <input asp-for="State" class="form-control" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label asp-for="ZipCode" class="form-label">Zip Code</label>
                            <input asp-for="ZipCode" class="form-control" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label asp-for="Country" class="form-label">Country</label>
                            <select asp-for="Country" class="form-select">
                                <option value="">-- Select Country --</option>
                                <option value="United States">United States</option>
                                <option value="Canada">Canada</option>
                                <option value="United Kingdom">United Kingdom</option>
                                <option value="Australia">Australia</option>
                                <option value="India">India</option>
                                <option value="Germany">Germany</option>
                                <option value="France">France</option>
                                <option value="Japan">Japan</option>
                                <option value="China">China</option>
                                <option value="Brazil">Brazil</option>
                                <option value="Mexico">Mexico</option>
                                <option value="South Africa">South Africa</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="TimeZone" class="form-label">Time Zone</label>
                            <input asp-for="TimeZone" class="form-control" placeholder="e.g. Asia/Kolkata" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="Language" class="form-label">Language</label>
                            <input asp-for="Language" class="form-control" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="CountryLocale" class="form-label">Locale</label>
                            <input asp-for="CountryLocale" class="form-control" placeholder="e.g. en_US" />
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h4 class="section-title">System Settings</h4>
                    <div class="row g-3">
                        <div class="col-12 col-md-3">
                            <label asp-for="TimeFormat" class="form-label">Time Format</label>
                            <input asp-for="TimeFormat" class="form-control" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label asp-for="DateFormat" class="form-label">Date Format</label>
                            <input asp-for="DateFormat" class="form-control" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label asp-for="Currency" class="form-label">Currency</label>
                            <input asp-for="Currency" class="form-control" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label asp-for="SalespersonCode" class="form-label">Salesperson Code</label>
                            <input asp-for="SalespersonCode" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-save w-100 w-md-auto">💾 Update User</button>
                </div>
            </form>
        </div>
    </div>
</div>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Publisher_CRM</RootNamespace>

	  <NoWarn>$(NoWarn);NU1903;NU1902</NoWarn>
	  <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
